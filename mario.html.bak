<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Super Mario World: Yoshi's Island 1</title>
<style>
:root{color-scheme:dark}*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;background:#0b0916;font-family:Consolas,"Courier New",monospace}body{display:grid;place-items:center;background:radial-gradient(circle at 50% 38%,#312b4b 0,#141124 54%,#090711 100%)}main{width:768px;padding:0;display:flex;flex-direction:column;gap:9px;align-items:center}#frame{width:768px;aspect-ratio:8/7;background:#000;border:0;border-radius:2px;box-shadow:0 0 0 3px #171225,0 0 0 6px #635884,0 16px 54px #000b;overflow:hidden}canvas{display:block;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;touch-action:none}#help{color:#bdb5d0;text-align:center;font-size:11px;white-space:nowrap;text-shadow:1px 1px #000}kbd{padding:1px 4px;border:1px solid #776c99;border-radius:2px;color:#fff;background:#25203c;font:inherit}@media(max-height:705px),(max-width:820px){main,#frame{width:512px}#help{font-size:9px}}@media(max-width:540px){main,#frame{width:256px}#help{font-size:7px;white-space:normal;line-height:1.5}}
</style></head><body><main><div id="frame"><canvas id="game" width="256" height="224" tabindex="0" aria-label="Game canvas"></canvas></div><div id="help"><kbd>Arrows</kbd> move · <kbd>Z</kbd> run/action · <kbd>X</kbd> jump · <kbd>C</kbd> spin · Mouse: steer + left jump + right run + middle spin</div></main>
<script>
"use strict";
// Core ------------------------------------------------------------------------
const canvas=document.querySelector("canvas"),ctx=canvas.getContext("2d"),W=256,H=224,T=16,STEP=1/60,SAVE_KEY="prism-isles-save",SAVE_VERSION=3;
ctx.imageSmoothingEnabled=false;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),approach=(v,t,n)=>v<t?Math.min(t,v+n):Math.max(t,v-n),overlap=(a,b)=>a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;
const hash=(x,y,s=0)=>{let n=(x*374761393+y*668265263+s*69069)|0;n=(n^(n>>>13))*1274126177;return((n^(n>>>16))>>>0)/4294967296};
const input={down:new Set,pressed:new Set,released:new Set,held(...c){return c.some(k=>this.down.has(k))},hit(...c){return c.some(k=>this.pressed.has(k))},edges(){this.pressed.clear();this.released.clear()},reset(){this.down.clear();this.edges()}};
addEventListener("keydown",e=>{if(["ArrowLeft","ArrowRight","ArrowUp","ArrowDown","Space"].includes(e.code))e.preventDefault();if(!input.down.has(e.code))input.pressed.add(e.code);input.down.add(e.code);audio.unlock()});
addEventListener("keyup",e=>{input.down.delete(e.code);input.released.add(e.code)});addEventListener("blur",()=>input.reset());document.addEventListener("visibilitychange",()=>document.hidden&&input.reset());canvas.addEventListener("pointerdown",()=>{canvas.focus();audio.unlock()});
const mouse={active:false,x:128,y:112};function virtualDown(code){if(!input.down.has(code))input.pressed.add(code);input.down.add(code)}function virtualUp(code){if(input.down.delete(code))input.released.add(code)}function clearMouse(){mouse.active=false;["MouseLeft","MouseRight","MouseUp","MouseDown","MouseJump","MouseRun","MouseSpin","MouseReserve"].forEach(virtualUp)}function steerMouse(e){if(game.mode!=="level"||!game.player)return;const r=canvas.getBoundingClientRect();mouse.x=(e.clientX-r.left)*W/r.width;mouse.y=(e.clientY-r.top)*H/r.height;mouse.active=true;["MouseLeft","MouseRight","MouseUp","MouseDown"].forEach(c=>input.down.delete(c));const px=game.player.x-game.camera.x+game.player.w/2,py=game.player.y-game.camera.y+game.player.h/2;if(mouse.x<px-10)input.down.add("MouseLeft");else if(mouse.x>px+10)input.down.add("MouseRight");if(Math.abs(mouse.x-px)<38){if(mouse.y<py-24)input.down.add("MouseUp");else if(mouse.y>py+24)input.down.add("MouseDown")}}
canvas.addEventListener("pointermove",steerMouse);canvas.addEventListener("pointerdown",e=>{e.preventDefault();canvas.focus();audio.unlock();if(game.mode!=="level"){if(e.button===0)virtualDown("Enter");return}steerMouse(e);if(e.button===0){if(mouse.x>=108&&mouse.x<=148&&mouse.y<=30)virtualDown("MouseReserve");else virtualDown("MouseJump")}else if(e.button===1)virtualDown("MouseSpin");else if(e.button===2)virtualDown("MouseRun");try{canvas.setPointerCapture(e.pointerId)}catch{}});addEventListener("pointerup",e=>{if(e.button===0){virtualUp("MouseJump");virtualUp("MouseReserve");virtualUp("Enter")}else if(e.button===1)virtualUp("MouseSpin");else if(e.button===2)virtualUp("MouseRun")});canvas.addEventListener("pointerleave",e=>{if(!e.buttons)clearMouse()});canvas.addEventListener("contextmenu",e=>e.preventDefault());
const left=()=>input.held("ArrowLeft","KeyA","MouseLeft"),right=()=>input.held("ArrowRight","KeyD","MouseRight"),up=()=>input.held("ArrowUp","KeyW","MouseUp"),down=()=>input.held("ArrowDown","KeyS","MouseDown"),run=()=>input.held("KeyZ","ShiftLeft","ShiftRight","MouseRun");

// Original procedural audio ---------------------------------------------------
const audio={ac:null,master:null,beat:-1,unlock(){if(!this.ac){const A=window.AudioContext||window.webkitAudioContext;if(!A)return;this.ac=new A;this.master=this.ac.createGain();this.master.gain.value=.09;this.master.connect(this.ac.destination)}if(this.ac.state==="suspended")this.ac.resume()},tone(f,d=.08,type="square",v=.2,slide=0){if(!this.ac||!f)return;const o=this.ac.createOscillator(),g=this.ac.createGain(),t=this.ac.currentTime;o.type=type;o.frequency.setValueAtTime(f,t);if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(30,f+slide),t+d);g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(g);g.connect(this.master);o.start(t);o.stop(t+d+.02)},sfx(n){const m={jump:[330,.09,"square",.22,100],spin:[190,.13,"sawtooth",.16,280],coin:[880,.07,"square",.18,350],dragon:[520,.2,"triangle",.25,520],hurt:[180,.3,"sawtooth",.2,-100],stomp:[120,.07,"square",.22,-40],power:[420,.35,"triangle",.22,500],pipe:[150,.28,"square",.14,-70],goal:[660,.35,"triangle",.25,440],key:[260,.45,"triangle",.25,650],switch:[110,.7,"square",.24,600],fire:[520,.08,"square",.14,-220],boss:[90,.35,"sawtooth",.25,-40],oneup:[440,.45,"triangle",.25,880]};if(m[n])this.tone(...m[n])},music(){if(game.mode!=="level")return;const b=Math.floor(game.tick/15);if(b===this.beat)return;this.beat=b;const s={grass:[220,277,330,415,330,277,247,330],house:[262,330,392,0,330,392,494,0],sky:[294,370,440,587,440,370,330,494],cave:[110,0,147,0,131,0,165,0],water:[196,247,294,247,220,277,330,277],palace:[262,330,392,523,392,330,294,440],castle:[98,123,110,147,98,165,123,110]}[game.level.area.theme];const f=s[b%s.length];if(f)this.tone(f,.11,game.level.area.theme==="castle"?"sawtooth":"triangle",.035)}};

// Save and overworld ----------------------------------------------------------
const fresh=()=>({version:SAVE_VERSION,lives:5,coins:0,score:0,stars:0,power:"small",reserve:null,yoshi:false,current:"grass",unlocked:["house","grass"],exits:{},dragons:{},switchOn:false,castleClear:false});
function loadSave(){try{const v=JSON.parse(localStorage.getItem(SAVE_KEY));return v&&v.version===SAVE_VERSION&&Array.isArray(v.unlocked)&&v.exits?Object.assign(fresh(),v):fresh()}catch{return fresh()}}function store(){try{localStorage.setItem(SAVE_KEY,JSON.stringify(game.save))}catch{}}function resetSave(){game.save=fresh();store();enterTitle()}
const NODES={house:{x:30,y:163,name:"Yoshi's House",normal:"grass",edges:["grass"]},grass:{x:67,y:151,name:"Yoshi's Island 1",normal:"athletic",edges:["house","athletic"]},athletic:{x:104,y:125,name:"2  Cloudstep Cliffs",normal:"cave",edges:["grass","cave"]},cave:{x:139,y:146,name:"3  Echoing Grotto",normal:"water",secret:"switch",edges:["athletic","water","switch"]},water:{x:177,y:161,name:"4  Tidal Tunnel",normal:"switch",edges:["cave","switch"]},switch:{x:164,y:105,name:"Amber Switch Hall",normal:"castle",edges:["cave","water","castle"]},castle:{x:213,y:83,name:"Reznor Ridge Keep",normal:null,edges:["switch"]}};

// Data-driven areas -----------------------------------------------------------
function area(id,w,theme,build){const a={id,w,h:14,theme,tiles:new Map,contents:new Map,turning:new Map,objects:[],enemies:[],platforms:[],waterline:null,spawn:{x:24,y:150}};const put=(x,y,t="G")=>a.tiles.set(x+","+y,t),ground=(x0,x1,y=12,t="G")=>{for(let x=x0;x<=x1;x++)for(let r=y;r<14;r++)put(x,r,t)},ledge=(x,y,n,t="B")=>{for(let i=0;i<n;i++)put(x+i,y,t)},q=(x,y,c="coin")=>{put(x,y,"Q");a.contents.set(x+","+y,c)},obj=(type,x,y,o={})=>a.objects.push(Object.assign({type,x:x*T,y:y*T,alive:true},o)),enemy=(type,x,y,o={})=>a.enemies.push(Object.assign({type,x:x*T,y:y*T},o)),pipe=(x,y,to,tx,ty,style="green",launch=false)=>{const top=style==="blue"?"v":"p",body=style==="blue"?"V":"P";put(x,y,top);put(x+1,y,top);for(let r=y+1;r<14;r++){put(x,r,body);put(x+1,r,body)}obj("pipe",x,y,{w:32,h:18,to,tx,ty,style,launch})};build({a,put,ground,ledge,q,obj,enemy,pipe});return a}
const goal=(obj,x)=>obj("goal",x,3,{h:9*T});
const LEVELS={
house:{name:"YOSHI'S NOOK",time:300,areas:{main:()=>area("main",38,"house",({a,ground,ledge,q,obj})=>{ground(0,37);ledge(7,9,4,"W");ledge(17,8,3,"W");q(11,8,"mushroom");obj("message",6,10,{text:"X JUMPS · C SPIN-JUMPS\nHOLD Z TO RUN AND CARRY"});obj("yoshi",20,10);[[9,7],[15,8],[23,9],[28,8],[33,9]].forEach(p=>obj("dragon",...p));goal(obj,35)})}},
grass:{name:"YOSHI'S ISLAND 1",time:300,areas:{main:()=>area("main",160,"grass",({a,put,ground,ledge,q,obj,enemy,pipe})=>{const slope=(x0,count,up,base=12)=>{for(let i=0;i<count;i++){const c=x0+i,r=up?base-1-i:base-count+i;put(c,r,up?"/":"\\");for(let y=r+1;y<14;y++)put(c,y,"G")}};ground(0,5);slope(6,4,true);slope(10,4,false);ground(14,26);slope(27,4,true);ground(31,41,8);ground(42,42);for(let x=43;x<55;x+=4){slope(x,2,true);slope(x+2,2,false)}ground(55,67);ground(68,90);ground(91,95,9);ground(96,100,7);ground(101,103,5);slope(104,7,false,12);ground(111,113,13);ground(114,133);ground(134,142,8);ground(143,159);obj("slopePipe",27,8,{direction:"up"});obj("flyingPrize",18,7,{kind:"mushroom",w:16,h:16,homeX:18*T,homeY:7*T});obj("dragon",9,6,{coinId:0});obj("dragon",48,6,{coinId:1});obj("dragon",102,3,{coinId:3});obj("dragon",148,8,{coinId:4});obj("bush",3,10,{variant:0});obj("bush",23,10,{variant:1});obj("bush",38,10,{variant:0,hiddenPower:"mushroom"});obj("bush",57,10,{variant:1});obj("bush",78,10,{variant:0});obj("bush",115,11,{variant:1});obj("bush",137,6,{variant:0});obj("message",82,10,{text:"THE BOX AT THE TOP OF THE SCREEN HOLDS A SPARE ITEM. PRESS V TO DROP IT."});obj("message",118,10,{text:"HOLD Z TO PICK UP A SHELL. HOLD UP AS YOU RELEASE Z TO THROW IT UPWARD."});obj("midpoint",75,8);pipe(68,10,"bonus",3,7,"blue");pipe(83,10,null);pipe(144,10,null);enemy("piranha",68,8);enemy("piranha",83,8);enemy("piranha",144,8);ledge(66,9,2,"B");put(122,7,"B");a.contents.set("122,7","oneup");q(135,7,"fire");enemy("slidingKoopa",8,5,{vx:-1.35});[21,33,39,43,49,55,60,76,87,92,97,103,106,109,128,132,146,149].forEach((x,i)=>enemy("rex",x,i===7?9:6));[16,108,120,142].forEach(x=>enemy("banzai",x,8,{vx:0,state:"dormant"}));enemy("koopaRed",120,10,{state:"shell",vx:0});enemy("chuck",153,9);goal(obj,156)}),bonus:()=>area("bonus",24,"cave",({a,put,ground,ledge,obj,pipe})=>{ground(0,23);ledge(10,9,5,"B");for(let x=5;x<=10;x++)obj("coin",x,7);obj("dragon",13,8,{coinId:2});pipe(2,10,null);pipe(20,10,"main",73,7,"green",true);a.spawn={x:3*T,y:7*T}})}},
athletic:{name:"CLOUDSTEP CLIFFS",time:380,areas:{main:()=>area("main",78,"sky",({a,ground,ledge,q,obj,enemy})=>{ground(0,12);ground(67,77);[[13,10,5],[20,8,4],[27,6,5],[36,9,4],[44,7,5],[53,5,5],[61,8,6]].forEach(p=>ledge(...p,"C"));a.platforms.push({x:18*T,y:145,w:42,h:8,axis:"y",range:42,speed:.8,phase:0},{x:34*T,y:125,w:48,h:8,axis:"x",range:52,speed:1,phase:60},{x:52*T,y:103,w:42,h:8,axis:"y",range:36,speed:.7,phase:120});q(28,5,"cape");obj("midpoint",39,6);[[9,9],[23,6],[38,7],[55,3],[69,9]].forEach(p=>obj("dragon",...p));enemy("koopaGreen",22,6);enemy("bullet",33,4);enemy("koopaRed",45,5);enemy("bullet",57,5);goal(obj,74)})}},
cave:{name:"ECHOING GROTTO",time:420,areas:{main:()=>area("main",96,"cave",({a,put,ground,ledge,q,obj,enemy,pipe})=>{ground(0,25);ground(28,51);ground(54,95);for(let x=8;x<17;x++)put(x,11,"/");for(let x=17;x<25;x++)put(x,11,"\\");ledge(31,9,7,"R");ledge(43,7,5,"R");ledge(58,9,8,"R");q(34,8,"fire");q(62,8,"cape");obj("midpoint",48,5);[[10,8],[29,8],[45,5],[66,7],[83,8]].forEach(p=>obj("dragon",...p));obj("key",68,9);obj("keyhole",77,8);obj("pswitch",40,10);for(let x=80;x<87;x++)put(x,10,"D");enemy("galoomba",19,9);enemy("koopaGreen",33,8);enemy("koopaRed",53,10);enemy("boo",71,6);pipe(88,10,"bonus",3,8);goal(obj,93)}),bonus:()=>area("bonus",24,"cave",({ground,ledge,obj,enemy,pipe})=>{ground(0,23);ledge(5,8,13,"R");for(let x=6;x<18;x++)obj("coin",x,7);obj("oneup",12,6);pipe(2,10,"main",87,8);enemy("boo",18,8)})}},
water:{name:"TIDAL TUNNEL",time:420,areas:{main:()=>area("main",74,"water",({a,ground,ledge,q,obj,enemy,pipe})=>{ground(0,73);a.waterline=52;ledge(10,8,5,"K");ledge(23,6,5,"K");ledge(37,9,5,"K");ledge(51,7,4,"K");q(25,5,"fire");obj("midpoint",39,7);[[8,6],[21,4],[35,7],[50,5],[65,8]].forEach(p=>obj("dragon",...p));enemy("fish",14,6);enemy("fish",30,9);enemy("fish",45,5);enemy("fish",59,8);pipe(55,10,"reef",2,7);goal(obj,71)}),reef:()=>area("reef",30,"water",({a,ground,ledge,obj,enemy,pipe})=>{ground(0,29);a.waterline=0;ledge(7,8,5,"K");ledge(16,5,6,"K");for(let x=4;x<25;x+=2)obj("coin",x,3+x%5);obj("oneup",19,4);enemy("fish",10,5);enemy("fish",22,8);pipe(2,10,"main",54,8)})}},
switch:{name:"AMBER SWITCH HALL",time:300,areas:{main:()=>area("main",58,"palace",({ground,ledge,q,obj,enemy})=>{ground(0,57);ledge(9,9,5,"Y");ledge(21,7,6,"Y");ledge(35,9,6,"Y");for(let x=14;x<43;x+=3)obj("coin",x,5+x%3);[[7,9],[18,6],[29,8],[40,7],[50,9]].forEach(p=>obj("dragon",...p));q(23,6,"cape");enemy("koopaRed",16,10);enemy("rex",32,10);obj("palaceSwitch",51,10)})}},
castle:{name:"REZNOR RIDGE KEEP",time:480,areas:{main:()=>area("main",78,"castle",({put,ground,ledge,q,obj,enemy,pipe})=>{ground(0,14);ground(18,34);ground(38,55);ground(59,77);for(let x=15;x<18;x++){put(x,12,"L");put(x,11,"U")}for(let x=35;x<38;x++){put(x,12,"L");put(x,11,"U")}for(let x=56;x<59;x++){put(x,12,"L");put(x,11,"U")}ledge(21,8,5,"S");ledge(42,7,5,"S");q(25,7,"fire");obj("midpoint",40,5);[[10,9],[23,6],[41,5],[53,8],[67,8]].forEach(p=>obj("dragon",...p));enemy("lavaBubble",16,10);enemy("crusher",31,4);enemy("koopaRed",44,6);enemy("lavaBubble",57,10);enemy("crusher",65,3);pipe(73,10,"boss",2,8)}),boss:()=>area("boss",32,"castle",({ground,obj,enemy})=>{ground(0,31);enemy("iggy",22,7);obj("bossExit",27,9,{alive:false})})}}
};

// Modes, loading, fixed simulation -------------------------------------------
const game={mode:"title",tick:0,save:loadSave(),node:"house",mapTarget:null,mapT:0,level:null,player:null,camera:{x:0,y:0},message:"",messageTick:0,transition:0,clear:null,debug:false,titleChoice:0,deathTick:0};
function enterTitle(){Object.assign(game,{mode:"title",level:null,player:null,titleChoice:0,transition:0})}
function enterMap(id=game.save.current){game.mode="map";game.node=NODES[id]?id:"house";game.save.current=game.node;game.mapTarget=null;game.level=null;game.player=null;game.transition=20;store()}
function player(x,y){const power=game.save.power||"small",p={x,y,prevX:x,prevY:y,w:12,h:power==="small"?15:27,vx:0,vy:0,power,reserve:game.save.reserve,onGround:false,facing:1,crouch:false,sliding:false,spin:false,spinT:0,inv:0,pMeter:0,flight:"none",held:null,key:false,yoshi:null,swimming:false,anim:0};if(game.save.yoshi)p.yoshi={type:"yoshi",x,y,w:18,h:18,tongue:0,shell:null,facing:1,alive:true};return p}
function loadLevel(id,areaId="main",spawn=null,keep=false){const d=LEVELS[id];if(!d||!d.areas[areaId])return false;const a=d.areas[areaId](),old=keep?game.player:null;instantiate(a);game.level={id,def:d,areaId,area:a,time:d.time*60,dragons:new Set(game.save.dragons[id]||[]),midpoint:null,pSwitch:0,bossDone:false};game.player=old||player(0,0);const s=spawn||a.spawn;Object.assign(game.player,{x:s.x,y:s.y,vx:0,vy:0,onGround:false,key:false,held:null});game.camera.x=clamp(s.x-80,0,Math.max(0,a.w*T-W));game.camera.y=0;game.mode="level";game.transition=24;game.message=d.name;game.messageTick=0;audio.beat=-1;return true}
function instantiate(a){a.liveObjects=a.objects.map((o,i)=>Object.assign({id:a.id+"o"+i,w:o.w||12,h:o.h||12},o));a.liveEnemies=a.enemies.map((e,i)=>makeEnemy(e,i));a.livePlatforms=a.platforms.map((p,i)=>Object.assign({id:i,baseX:p.x,baseY:p.y,dx:0,dy:0,prevX:p.x,prevY:p.y},p))}
function makeEnemy(e,i){const d={galoomba:[14,14],koopaGreen:[14,24],koopaRed:[14,24],slidingKoopa:[14,22],rex:[18,24],piranha:[14,22],bullet:[16,12],banzai:[32,28],chuck:[20,28],boo:[16,16],fish:[16,12],lavaBubble:[12,12],crusher:[28,32],iggy:[20,28]}[e.type]||[14,14];return Object.assign({id:i,w:d[0],h:d[1],vx:e.type==="bullet"?-2:e.type==="fish"?-.7:-.55,vy:0,alive:true,active:false,state:"walk",timer:0,dir:-1,hp:e.type==="iggy"?5:e.type==="chuck"?3:e.type==="rex"?2:1,homeY:e.y},e)}
function update(){game.tick++;audio.music();if(game.transition>0)game.transition--;if(input.hit("F3"))game.debug=!game.debug;if(game.mode==="title")updateTitle();else if(game.mode==="map")updateMap();else if(game.mode==="level")updateLevel();else if(game.mode==="pause")updatePause();else if(game.mode==="death")updateDeath();else if(game.mode==="clear")updateClear();else if(game.mode==="gameover")updateGameOver();else if(game.mode==="ending"&&input.hit("Enter","Space","KeyZ"))enterMap("castle");input.edges()}
function updateTitle(){if(input.hit("ArrowUp","ArrowDown","KeyW","KeyS"))game.titleChoice=1-game.titleChoice;if(input.hit("Enter","Space","KeyZ")){if(game.titleChoice)resetSave();else enterMap(game.save.current)}}
function accessible(id){return game.save.unlocked.includes(id)}
function updateMap(){if(game.mapTarget){if(++game.mapT>=18){game.node=game.mapTarget;game.mapTarget=null;game.mapT=0;game.save.current=game.node;store()}return}if(input.hit("Enter","Space","KeyZ")){loadLevel(game.node);return}const n=NODES[game.node],dx=(input.hit("ArrowRight","KeyD")?1:0)-(input.hit("ArrowLeft","KeyA")?1:0),dy=(input.hit("ArrowDown","KeyS")?1:0)-(input.hit("ArrowUp","KeyW")?1:0);if(dx||dy){let best=null,score=1e9;for(const id of n.edges){if(!accessible(id))continue;const q=NODES[id],vx=q.x-n.x,vy=q.y-n.y;if(vx*dx+vy*dy<=0)continue;const s=Math.abs(vx*dy-vy*dx)*3+Math.hypot(vx,vy);if(s<score){score=s;best=id}}if(best){game.mapTarget=best;game.mapT=0;audio.sfx("coin")}}if(input.hit("KeyN"))resetSave()}
function updatePause(){if(input.hit("Escape","KeyP","Enter"))game.mode="level";else if(input.hit("KeyQ"))enterMap(game.level.id);else if(input.hit("KeyN"))resetSave()}
function updateDeath(){game.deathTick++;game.player.y+=game.player.vy;game.player.vy+=.25;if(game.deathTick>90){game.save.power="small";game.save.yoshi=false;if(--game.save.lives<0){game.mode="gameover";game.deathTick=0;store()}else{const l=game.level,m=l.midpoint;loadLevel(l.id,"main",m&&{x:m.x,y:m.y})}}}
function updateGameOver(){if(++game.deathTick>90&&input.hit("Enter","Space","KeyZ")){game.save.lives=5;store();enterMap("house")}}
function updateClear(){const c=game.clear;c.t++;if(c.t<100&&game.level.time>0){const n=Math.min(60,game.level.time);game.level.time-=n;game.save.score+=Math.floor(n/3)}if(c.t===110){const node=NODES[c.id],next=c.secret?node.secret:node.normal;game.save.exits[c.id]=Object.assign(game.save.exits[c.id]||{},{[c.secret?"secret":"normal"]:true});if(next&&!accessible(next))game.save.unlocked.push(next);game.save.current=next||c.id;game.save.power=game.player.power;game.save.reserve=game.player.reserve;game.save.yoshi=!!game.player.yoshi;store()}if(c.t>150){if(c.id==="castle"){game.save.castleClear=true;store();game.mode="ending"}else enterMap(game.save.current)}}
function show(s,t=120){game.message=s;game.messageTick=t}

// Tiles and collision ---------------------------------------------------------
function tileAt(a,c,r){if(c<0||c>=a.w||r<0)return"G";if(r>=a.h)return"";let t=a.tiles.get(c+","+r)||"";if(t==="D"&&game.level.pSwitch>0)return"";if(t==="U")return game.save.switchOn?"Y":"";return t}
const solid=t=>!!t&&"GBQXWpvVPCRKYSUF".includes(t);
function rectHits(a,x,y,w,h){const c0=Math.floor(x/T),c1=Math.floor((x+w-.01)/T),r0=Math.floor(y/T),r1=Math.floor((y+h-.01)/T);for(let r=r0;r<=r1;r++)for(let c=c0;c<=c1;c++){const t=tileAt(a,c,r);if(solid(t))return{c,r,t}}return null}
function slopeInfo(a,x,y){const c=Math.floor(x/T),lx=x-c*T,r=Math.floor(y/T);for(const rr of [r,r-1]){const t=tileAt(a,c,rr);if(t==="/"||t==="\\")return{c,r:rr,t,floor:t==="/"?(rr+1)*T-lx:rr*T+lx}}return null}function slopeFloor(a,x,y){return slopeInfo(a,x,y)?.floor??null}
function setHeight(p,h){if(h===p.h)return true;const bottom=p.y+p.h,ny=bottom-h;if(h>p.h&&rectHits(game.level.area,p.x,ny,p.w,h))return false;p.y=ny;p.h=h;return true}
function moveX(e,dx,a){const n=Math.max(1,Math.ceil(Math.abs(dx)/4)),s=dx/n;for(let i=0;i<n;i++){e.x+=s;const hit=rectHits(a,e.x,e.y,e.w,e.h);if(hit){e.x=s>0?hit.c*T-e.w:(hit.c+1)*T;e.vx=0;return}}}
function moveY(p,dy,a){p.onGround=false;const n=Math.max(1,Math.ceil(Math.abs(dy)/4)),s=dy/n;for(let i=0;i<n;i++){p.y+=s;const hit=rectHits(a,p.x+1,p.y,p.w-2,p.h);if(hit){if(s>0){p.y=hit.r*T-p.h;p.onGround=true}else{p.y=(hit.r+1)*T;hitBlock(a,hit.c,hit.r,p)}p.vy=0;return}for(const o of a.liveObjects)if(o.alive&&o.type==="flyingPrize"&&p.x+p.w>o.x&&p.x<o.x+o.w&&p.y+p.h>o.y&&p.y<o.y+o.h){if(s<0){p.y=o.y+o.h;if(!o.used)activateFlyingPrize(a,o)}else{p.y=o.y-p.h;p.onGround=true}p.vy=0;return}}if(p.vy>=0){const foot=p.y+p.h+2,sl=slopeFloor(a,p.x+p.w/2,foot);if(sl!==null&&foot>=sl&&p.y+p.h<=sl+5){p.y=sl-p.h;p.vy=0;p.onGround=true}}for(const q of a.livePlatforms)if(p.vy>=0&&p.x+p.w>q.x&&p.x<q.x+q.w&&p.y+p.h>=q.y&&p.y+p.h<=q.y+Math.max(6,p.vy+5)){p.y=q.y-p.h;p.vy=0;p.onGround=true;p.x+=q.dx}}
function activateFlyingPrize(a,o){o.used=true;spawnPower(a,o.x+1,o.y-14,o.kind||"mushroom");audio.sfx("coin")}
function hitBlock(a,c,r,p){const k=c+","+r,t=tileAt(a,c,r),kind=a.contents.get(k);if(t==="Q"||(t==="B"&&kind)){a.tiles.set(k,"X");spawnPower(a,c*T+2,r*T-14,kind||"coin");a.contents.delete(k);audio.sfx(kind==="oneup"?"oneup":"coin")}else if(t==="B"){if(p.spin&&p.power!=="small"){a.tiles.delete(k);game.save.score+=50;audio.sfx("stomp")}else{a.tiles.delete(k);a.turning.set(k,180);audio.sfx("stomp")}}}
function updateTurnBlocks(a){for(const [k,n]of a.turning){if(n<=1){a.turning.delete(k);if(!a.tiles.has(k))a.tiles.set(k,"B")}else a.turning.set(k,n-1)}}
function spawnPower(a,x,y,kind){if(kind==="coin"){addCoin();return}a.liveObjects.push({id:"spawn"+game.tick,type:"power",kind,x,y,w:14,h:14,alive:true,vx:kind==="fire"?0:.7,vy:-2})}
function addCoin(){game.save.coins++;game.save.score+=100;audio.sfx("coin");if(game.save.coins>=100){game.save.coins-=100;game.save.lives++;audio.sfx("oneup")}}

// Player movement and actions -------------------------------------------------
function updateLevel(){if(input.hit("Escape","KeyP")){game.mode="pause";return}const l=game.level,p=game.player,a=l.area;if(game.messageTick>0)game.messageTick--;if(p.inv>0)p.inv--;if(--l.time<=0){killPlayer();return}if(l.pSwitch>0)l.pSwitch--;updateTurnBlocks(a);updatePlatforms(a);updatePlayerSMW(l,p);updateEnemies(l,p);updateObjects(l,p);updateProjectiles(l,p);updateCamera(l,p);if(p.y>H+80)killPlayer()}
function updatePlatforms(a){for(const p of a.livePlatforms){p.prevX=p.x;p.prevY=p.y;const off=Math.sin((game.tick+p.phase)*p.speed/60)*p.range;p.x=p.baseX+(p.axis==="x"?off:0);p.y=p.baseY+(p.axis==="y"?off:0);p.dx=p.x-p.prevX;p.dy=p.y-p.prevY}}
function updatePlayer(l,p){const a=l.area;p.prevX=p.x;p.prevY=p.y;p.anim++;const wasGround=p.onGround;p.swimming=a.waterline!==null&&p.y+p.h/2>a.waterline;const crouch=down()&&p.onGround&&!p.yoshi;if(crouch)setHeight(p,14);else setHeight(p,p.power==="small"?15:27);p.crouch=crouch;let dir=(right()?1:0)-(left()?1:0),max=run()?4.85:2.35;if(p.yoshi)max+=.25;if(crouch)dir=0;if(dir){p.facing=dir;const reverse=p.vx&&Math.sign(p.vx)!==dir,acc=p.onGround?(reverse?.34:.12):.055;p.vx=approach(p.vx,dir*max,acc)}else p.vx=approach(p.vx,0,p.onGround?.16:.012);if(p.onGround&&run()&&Math.abs(p.vx)>4.25)p.pMeter=clamp(p.pMeter+2,0,112);else p.pMeter=clamp(p.pMeter-(p.onGround?2:1),0,112);
const jump=input.hit("KeyZ","Space"),spin=input.hit("KeyC");if(p.swimming){p.vy=clamp(p.vy+.08,-3,2.2);p.vx*=.985;if(jump||spin){p.vy=-2.6;audio.sfx("jump")}}else if((jump||spin)&&p.onGround&&!crouch){p.vy=-5.25-Math.min(1,Math.abs(p.vx)*.16);p.onGround=false;p.spin=spin;p.spinT=spin?24:0;if(p.power==="cape"&&p.pMeter>=112)p.flight="rise";audio.sfx(spin?"spin":"jump")}else{const held=input.held("KeyZ","Space","KeyC");p.vy+=p.flight!=="none"?.18:(held&&p.vy<0?.22:.36);if(!held&&p.vy<0)p.vy+=.3;p.vy=Math.min(7,p.vy)}
if(p.flight!=="none"){if(p.flight==="rise"){p.vy=Math.min(p.vy,-1.2);if(p.vy>=-1.3)p.flight="glide"}else if(down()){p.flight="dive";p.vy=Math.min(4,p.vy+.18)}else if(up()){p.flight="glide";p.vy=Math.max(-2.2,p.vy-.18)}else p.vy=Math.min(1.25,p.vy)}if(p.onGround)p.flight="none";if(p.spinT>0)p.spinT--;else p.spin=false;if(input.hit("KeyV"))releaseReserve(p);if(input.hit("KeyX","ShiftLeft","ShiftRight"))action(l,p);if(p.yoshi&&spin){const y=p.yoshi;y.x=p.x;y.y=p.y+p.h-18;y.vx=-p.facing*1.2;y.runaway=180;l.area.liveObjects.push(y);p.yoshi=null;p.vy=-4;audio.sfx("jump")}moveX(p,p.vx,a);moveY(p,p.vy,a);p.x=clamp(p.x,0,a.w*T-p.w);if(wasGround&&!p.onGround&&down()&&Math.abs(p.vx)>2.7)p.vx*=1.02;if(p.yoshi){p.yoshi.x=p.x-2;p.yoshi.y=p.y+p.h-17;p.yoshi.facing=p.facing}}
function updatePlayerSMW(l,p){
  const a=l.area;
  p.prevX=p.x;p.prevY=p.y;p.anim++;
  p.swimming=a.waterline!==null&&p.y+p.h/2>a.waterline;
  const slope=slopeInfo(a,p.x+p.w/2,p.y+p.h+2),sliding=down()&&p.onGround&&!!slope&&!p.yoshi;
  const crouch=down()&&p.onGround&&!p.yoshi&&!sliding;
  if(crouch)setHeight(p,14);else setHeight(p,p.power==="small"?15:27);
  p.crouch=crouch;p.sliding=sliding;

  let dir=(right()?1:0)-(left()?1:0);
  if(crouch)dir=0;
  const speed=Math.abs(p.vx);
  const walkTarget=1.25,runTarget=speed>=2.125?3:2.25;
  const target=(run()?runTarget:walkTarget)+(p.yoshi ? .15 : 0);
  if(dir&&!sliding){
    const reversing=p.vx!==0&&Math.sign(p.vx)!==dir;
    p.facing=dir;
    const accel=p.onGround?(reversing?(run()?.20:.14):.03125):(reversing?.04:.01875);
    p.vx=approach(p.vx,dir*target,accel);
  }else if(!sliding)p.vx=approach(p.vx,0,p.onGround?.0625:.008);
  if(sliding){const downhill=slope.t==="/"?-1:1;p.facing=downhill;p.vx=approach(p.vx,downhill*2.65,.11)}

  if(p.onGround&&run()&&Math.abs(p.vx)>=2.18)p.pMeter=clamp(p.pMeter+2,0,112);
  else p.pMeter=clamp(p.pMeter-1,0,112);

  const jumpPress=input.hit("KeyX","Space","MouseJump"),spinPress=input.hit("KeyC","MouseSpin");
  let launched=false;
  if(spinPress&&p.yoshi){
    const y=p.yoshi;y.x=p.x-p.facing*18;y.y=p.y+p.h-18;y.vx=-p.facing*1.5;y.runaway=180;
    a.liveObjects.push(y);p.yoshi=null;p.vy=-4.5;p.onGround=false;launched=true;audio.sfx("jump");
  }

  if(p.swimming){
    p.vx*=.984;p.vy=clamp(p.vy+.08,-2.5,2);
    if(jumpPress||spinPress){p.vy=-2.25;audio.sfx("jump")}
  }else if(!launched&&(jumpPress||spinPress)&&p.onGround&&!crouch){
    const hs=Math.abs(p.vx);
    let impulse=hs<1.25?-5:hs<2.25?-5.5:-6;
    const doSpin=spinPress&&!p.held;
    if(doSpin)impulse+=.375;
    p.vy=impulse;p.onGround=false;p.spin=doSpin;p.spinT=doSpin?28:0;launched=true;
    if(p.power==="cape"&&p.pMeter>=112&&!doSpin)p.flight="rise";
    audio.sfx(doSpin?"spin":"jump");
  }

  if(!p.swimming&&!launched){
    const jumpHeld=p.spin?input.held("KeyC","MouseSpin"):input.held("KeyX","Space","MouseJump");
    p.vy=Math.min(4,p.vy+(jumpHeld?.1875:.375));
  }
  if(p.flight!=="none"){
    if(p.flight==="rise"){p.vy=Math.min(p.vy,-1.15);if(p.vy>=-1.2)p.flight="glide"}
    else if(down()){p.flight="dive";p.vy=Math.min(3,p.vy+.125)}
    else if(up()){p.flight="glide";p.vy=Math.max(-1.5,p.vy-.125)}
    else p.vy=Math.min(.75,p.vy);
  }
  if(p.onGround)p.flight="none";
  if(p.spinT>0)p.spinT--;else p.spin=false;
  if(input.hit("KeyV","MouseReserve"))releaseReserve(p);
  if(run()&&!p.yoshi&&!p.held){const sh=a.liveEnemies.find(e=>e.alive&&e.state==="shell"&&Math.abs(e.x-p.x)<18&&Math.abs(e.y-p.y)<18);if(sh){p.held=sh;sh.state="held";audio.sfx("coin")}}
  if(input.hit("KeyZ","ShiftLeft","ShiftRight","MouseRun"))action(l,p);
  moveX(p,p.vx,a);moveY(p,p.vy,a);p.x=clamp(p.x,0,a.w*T-p.w);
  if(p.yoshi){p.yoshi.x=p.x-2;p.yoshi.y=p.y+p.h-17;p.yoshi.facing=p.facing}
}
function releaseReserve(p){if(!p.reserve)return;game.level.area.liveObjects.push({id:"reserve"+game.tick,type:"power",kind:p.reserve,x:p.x,y:34,w:14,h:14,alive:true,vx:0,vy:0});p.reserve=null;game.save.reserve=null;audio.sfx("power")}
function action(l,p){const a=l.area;if(p.yoshi){if(p.yoshi.shell){spitShell(p,a);return}p.yoshi.tongue=18;audio.sfx("spin");return}if(p.held)return;if(p.power==="fire"){a.liveObjects.push({id:"fire"+game.tick,type:"fireball",x:p.x+p.facing*10,y:p.y+8,w:7,h:7,vx:p.facing*3.3,vy:-1,alive:true,bounces:3});audio.sfx("fire");return}if(p.power==="cape"){p.spinT=18;p.spin=true;audio.sfx("spin");return}const sh=a.liveEnemies.find(e=>e.alive&&e.state==="shell"&&Math.abs(e.x-p.x)<20&&Math.abs(e.y-p.y)<20);if(sh){p.held=sh;sh.state="held"}}
function updateProjectiles(l,p){const a=l.area;for(const o of a.liveObjects){if(!o.alive||o.type!=="fireball")continue;o.vy+=.25;o.x+=o.vx;o.y+=o.vy;if(rectHits(a,o.x,o.y,o.w,o.h)){if(o.vy>0&&o.bounces-->0){o.vy=-2.8;o.y-=4}else o.alive=false}for(const e of a.liveEnemies)if(e.alive&&overlap(o,e)){damageEnemy(e,true);o.alive=false;break}if(o.x<0||o.x>a.w*T)o.alive=false}}

// Enemies, shells, Yoshi ------------------------------------------------------
function updateEnemies(l,p){const a=l.area;for(const e of a.liveEnemies){if(!e.alive)continue;if(!e.active){if(e.x>p.x+W+48||e.x<p.x-W)continue;e.active=true}e.timer++;if(e.state==="held"){e.x=p.x+p.facing*12;e.y=p.y+8;if(!run()){e.state="shell";if(up()){e.vx=p.facing*.65;e.vy=-5.2}else{e.vx=p.facing*4.6;e.vy=-.4}p.held=null;audio.sfx("spin")}continue}if(e.type==="bullet"){e.x+=e.vx;if(Math.abs(e.x-p.x)>300)e.alive=false}else if(e.type==="banzai"){if(e.state==="dormant"){e.state="fly";e.vx=-2.35;audio.sfx("boss")}e.x+=e.vx;if(e.x<game.camera.x-48)e.alive=false}else if(e.type==="chuck")updateChuck(e,p,a);else if(e.type==="boo"){if(p.facing!==Math.sign(e.x-p.x)){e.x+=Math.sign(p.x-e.x)*.45;e.y+=Math.sign(p.y-e.y)*.28}}else if(e.type==="fish"){e.x+=e.vx;e.y=e.homeY+Math.sin((game.tick+e.id*23)/28)*18;if(e.x<0)e.x=a.w*T}else if(e.type==="lavaBubble")e.y=e.homeY-Math.max(0,Math.sin((game.tick+e.id*40)/42))*70;else if(e.type==="crusher")updateCrusher(e,p,a);else if(e.type==="piranha")e.y=e.homeY-Math.max(0,Math.sin((game.tick+e.id*30)/45))*22;else if(e.type==="iggy")updateBoss(e,a);else if(e.type==="slidingKoopa")moveEnemy(e,a);else updateWalker(e,a);if(!e.alive)continue;
if(p.yoshi&&p.yoshi.tongue>0){const tongue={x:p.x+(p.facing>0?p.w:-32),y:p.y+5,w:32,h:9};if(overlap(tongue,e)&&!["crusher","iggy","banzai","chuck"].includes(e.type)){if(e.state==="shell"){p.yoshi.shell=e;e.alive=false}else{e.alive=false;game.save.score+=200}audio.sfx("stomp");continue}}if(e.state==="shell"&&Math.abs(e.vx)>1)for(const q of a.liveEnemies)if(q!==e&&q.alive&&q.active&&overlap(e,q)){damageEnemy(q,true);game.save.score+=200}if(overlap(p,e)&&p.inv===0){const stomp=p.vy>0&&p.prevY+p.h<=e.y+7&&!["piranha","crusher","lavaBubble"].includes(e.type);if(stomp){p.y=e.y-p.h;p.vy=p.spin?-4.3:-3.4;damageEnemy(e,p.spin);audio.sfx("stomp")}else if((p.spinT>0||p.sliding)&&e.type!=="crusher"){damageEnemy(e,true);audio.sfx("stomp")}else hurtPlayer(p)}}if(p.yoshi&&p.yoshi.tongue>0)p.yoshi.tongue--}
function updateWalker(e,a){if(e.state==="shell"){moveEnemy(e,a);return}e.vy+=.35;const old=e.x;e.x+=e.vx;if(rectHits(a,e.x,e.y,e.w,e.h)){e.x=old;e.vx*=-1}e.y+=e.vy;const h=rectHits(a,e.x,e.y,e.w,e.h);if(h){if(e.vy>0){e.y=h.r*T-e.h;e.vy=0;if(e.type==="koopaRed"){const px=e.vx<0?e.x-2:e.x+e.w+2;if(!rectHits(a,px,e.y+e.h+2,2,2))e.vx*=-1}}else e.vy=0}if(e.y>H+100)e.alive=false}
function moveEnemy(e,a){e.vy+=.35;const ox=e.x;e.x+=e.vx;if(rectHits(a,e.x,e.y,e.w,e.h)){e.x=ox;e.vx*=-1}e.y+=e.vy;const h=rectHits(a,e.x,e.y,e.w,e.h);if(h&&e.vy>0){e.y=h.r*T-e.h;e.vy=0}else if(h&&e.vy<0){e.y=(h.r+1)*T;e.vy=0;hitBlock(a,h.c,h.r,{spin:false,power:"small"})}else if(e.vy>=0){const sl=slopeFloor(a,e.x+e.w/2,e.y+e.h+2);if(sl!==null&&e.y+e.h<=sl+5){e.y=sl-e.h;e.vy=0}}}
function updateChuck(e,p,a){if(e.state==="charge"){e.vx=approach(e.vx,Math.sign(p.x-e.x)*1.55,.05);updateWalker(e,a);return}if(e.timer%72===0)e.vy=-4.4;e.vy=Math.min(4,e.vy+.28);e.y+=e.vy;const h=rectHits(a,e.x,e.y,e.w,e.h);if(h&&e.vy>0){e.y=h.r*T-e.h;e.vy=0}}
function updateCrusher(e,p,a){if(Math.abs(e.x+e.w/2-p.x-p.w/2)<30&&e.state==="walk"){e.state="drop";e.vy=1}if(e.state==="drop"){e.vy=Math.min(6,e.vy+.3);e.y+=e.vy;if(rectHits(a,e.x,e.y,e.w,e.h)){e.y=Math.floor((e.y+e.h)/T)*T-e.h;e.state="wait";e.timer=0}}else if(e.state==="wait"&&e.timer>50){e.y=approach(e.y,e.homeY,.6);if(e.y===e.homeY)e.state="walk"}}
function updateBoss(e,a){e.x+=e.vx;if(e.x<230||e.x>430)e.vx*=-1;if(e.timer%100===0){e.vy=-5;audio.sfx("boss")}e.vy+=.3;e.y+=e.vy;const h=rectHits(a,e.x,e.y,e.w,e.h);if(h&&e.vy>0){e.y=h.r*T-e.h;e.vy=0}}
function damageEnemy(e,strong=false){if(e.type==="iggy"){e.hp--;e.vx*=-1;e.vy=-3;if(e.hp<=0){e.alive=false;game.level.bossDone=true;const o=game.level.area.liveObjects.find(q=>q.type==="bossExit");if(o)o.alive=true;audio.sfx("goal")}return}if(e.type==="chuck"){e.hp-=strong?2:1;e.state="charge";e.vx=e.vx||-1.2;e.vy=-2.4;if(e.hp<=0){e.alive=false;game.save.score+=400}return}if(e.type.startsWith("koopa")&&!strong&&e.state!=="shell"){e.state="shell";e.h=14;e.y+=10;e.vx=0}else if(e.type==="rex"&&e.hp>1&&!strong){e.hp--;e.h=14;e.y+=10;e.vx*=1.6}else{e.alive=false;game.save.score+=100}}
function hurtPlayer(p){if(p.inv)return;if(p.yoshi){const y=p.yoshi;y.x=p.x;y.y=p.y+p.h-18;y.vx=-p.facing*2.6;y.runaway=180;game.level.area.liveObjects.push(y);p.yoshi=null;p.inv=90;audio.sfx("hurt");return}if(p.power!=="small"){if(!p.reserve)p.reserve=p.power==="super"?"mushroom":p.power;p.power="small";setHeight(p,15);p.inv=120;audio.sfx("hurt")}else killPlayer()}
function killPlayer(){if(game.mode!=="level")return;game.mode="death";game.deathTick=0;game.player.vy=-5;audio.sfx("hurt")}
function spitShell(p,a){const sh=p.yoshi.shell;sh.alive=true;sh.state="shell";sh.x=p.x+p.facing*16;sh.y=p.y;sh.vx=p.facing*5;if(sh.type==="koopaRed")for(let i=-1;i<=1;i++)a.liveObjects.push({id:"yf"+game.tick+i,type:"fireball",x:p.x,y:p.y,w:7,h:7,vx:p.facing*3.2,vy:i*1.2,alive:true,bounces:1});p.yoshi.shell=null;audio.sfx("fire")}

// Collectibles, pipes, exits --------------------------------------------------
function updateObjects(l,p){const a=l.area;for(const o of a.liveObjects){if(!o.alive)continue;if(o.type==="flyingPrize"){if(!o.used){o.x=o.homeX+Math.sin((game.tick+o.id.length*7)/32)*10;o.y=o.homeY+Math.sin((game.tick+o.id.length*11)/25)*4}continue}if(o.type==="bush"){if(o.hiddenPower&&!o.spawned&&p.x+p.w>o.x-4){o.spawned=true;spawnPower(a,o.x+3,o.y-13,o.hiddenPower)}continue}if(o.type==="slopePipe")continue;if(o.type==="power"){const ox=o.x;o.x+=o.vx||0;if(rectHits(a,o.x,o.y,o.w,o.h)){o.x=ox;o.vx=-(o.vx||0)}o.vy=Math.min(4,(o.vy||0)+.18);o.y+=o.vy;const h=rectHits(a,o.x,o.y,o.w,o.h);if(h){if(o.vy>0)o.y=h.r*T-o.h;else o.y=(h.r+1)*T;o.vy=0}if(overlap(p,o)){collectPower(p,o.kind);o.alive=false}continue}if(o.type==="fireball")continue;if(o.type==="yoshi"&&o.runaway){o.runaway--;o.x+=o.vx;o.vx*=.98;if(overlap(p,o)){mountYoshi(p);o.alive=false}continue}if(o.type==="pipe"&&o.to&&Math.abs(p.x-o.x)<20&&Math.abs(p.y+p.h-o.y)<12&&down()){transitionArea(o);return}if(!overlap(p,o))continue;if(o.type==="coin"){o.alive=false;addCoin()}else if(o.type==="oneup"){o.alive=false;game.save.lives++;audio.sfx("oneup")}else if(o.type==="dragon"){const n=o.coinId??Number(o.id.split("o").pop());if(!l.dragons.has(n)){l.dragons.add(n);game.save.dragons[l.id]=[...l.dragons];game.save.score+=1000;audio.sfx("dragon")}o.alive=false}else if(o.type==="midpoint"&&!l.midpoint){l.midpoint={x:o.x,y:o.y};o.hit=true;if(p.power==="small")collectPower(p,"mushroom");show("MIDWAY!",90)}else if(o.type==="goal")finishLevel(false);else if(o.type==="bossExit"&&l.bossDone)finishLevel(false);else if(o.type==="key"){p.key=true;o.alive=false;audio.sfx("key");show("A SECRET KEY!",90)}else if(o.type==="keyhole"&&p.key)finishLevel(true);else if(o.type==="pswitch"){o.alive=false;l.pSwitch=600;audio.sfx("switch");show("COINS AND BLOCKS SWAPPED!",120)}else if(o.type==="palaceSwitch"){o.alive=false;game.save.switchOn=true;audio.sfx("switch");show("AMBER BLOCKS ARE NOW SOLID!",120);finishLevel(false)}else if(o.type==="yoshi"){mountYoshi(p);o.alive=false}else if(o.type==="message"&&input.hit("ArrowUp","KeyW","MouseUp"))show(o.text,180)}if(p.held){p.held.x=p.x+p.facing*12;p.held.y=p.y+8}}
function collectPower(p,k){const rank={small:0,super:1,fire:2,cape:3},target=k==="mushroom"?"super":k;if((rank[p.power]||0)>=(rank[target]||0))p.reserve=k;else{if(p.h<=16&&!setHeight(p,27)){p.reserve=k;game.save.score+=1000;audio.sfx("power");show("ITEM MOVED TO RESERVE",75);return}if(p.power!=="small")p.reserve=p.power==="super"?"mushroom":p.power;p.power=target}game.save.score+=1000;audio.sfx("power")}
function mountYoshi(p){p.yoshi={type:"yoshi",x:p.x,y:p.y,w:18,h:18,tongue:0,shell:null,facing:p.facing,alive:true};audio.sfx("power");show("YOSHI JOINED! Z: TONGUE · C: DISMOUNT",120)}
function transitionArea(o){audio.sfx("pipe");const a=LEVELS[game.level.id].areas[o.to]();instantiate(a);game.level.areaId=o.to;game.level.area=a;Object.assign(game.player,{x:o.tx*T,y:o.ty*T,vx:0,vy:o.launch?-6:0,onGround:false});game.camera.x=clamp(game.player.x-80,0,Math.max(0,a.w*T-W));game.transition=28}
function finishLevel(secret){if(game.mode!=="level")return;if(game.level.dragons.size>=5)game.save.score+=5000;if(!secret)game.save.stars=(game.save.stars+clamp(5-Math.floor(game.player.y/40),1,5))%100;game.mode="clear";game.clear={id:game.level.id,secret,t:0};audio.sfx(secret?"key":"goal")}
function updateCamera(l,p){const a=l.area,max=Math.max(0,a.w*T-W),screenX=p.x-game.camera.x;let target=game.camera.x;if(screenX>144)target+=screenX-144;else if(screenX<96)target-=96-screenX;const manual=(input.held("KeyE")?48:0)-(input.held("KeyQ")?48:0);target+=manual;game.camera.x=clamp(approach(game.camera.x,target,manual?1.5:Math.max(.75,Math.abs(p.vx))),0,max);game.camera.y=approach(game.camera.y,clamp(p.y-105,0,Math.max(0,a.h*T-H)),1)}

// Rendering ------------------------------------------------------------------
const PAL={grass:{sky:"#0873c8",far:"#8fcde5",ground:"#d3ad61",edge:"#19cf35"},house:{sky:"#0873c8",far:"#8fcde5",ground:"#d3ad61",edge:"#19cf35"},sky:{sky:"#78c9ef",far:"#d4f6ff",ground:"#8bd681",edge:"#fff0a4"},cave:{sky:"#19183a",far:"#322756",ground:"#67507c",edge:"#a88bb6"},water:{sky:"#246ca8",far:"#3fa6be",ground:"#357a79",edge:"#7fd3b1"},palace:{sky:"#552f7d",far:"#8b5599",ground:"#cb8d39",edge:"#ffe074"},castle:{sky:"#211c2c",far:"#4d3543",ground:"#594653",edge:"#a88478"}};
const FONT5={
  " ":"00000/00000/00000/00000/00000/00000/00000",A:"01110/10001/10001/11111/10001/10001/10001",B:"11110/10001/10001/11110/10001/10001/11110",C:"01111/10000/10000/10000/10000/10000/01111",D:"11110/10001/10001/10001/10001/10001/11110",E:"11111/10000/10000/11110/10000/10000/11111",F:"11111/10000/10000/11110/10000/10000/10000",G:"01111/10000/10000/10111/10001/10001/01110",H:"10001/10001/10001/11111/10001/10001/10001",I:"11111/00100/00100/00100/00100/00100/11111",J:"00111/00010/00010/00010/10010/10010/01100",K:"10001/10010/10100/11000/10100/10010/10001",L:"10000/10000/10000/10000/10000/10000/11111",M:"10001/11011/10101/10101/10001/10001/10001",N:"10001/11001/11001/10101/10011/10011/10001",O:"01110/10001/10001/10001/10001/10001/01110",P:"11110/10001/10001/11110/10000/10000/10000",Q:"01110/10001/10001/10001/10101/10010/01101",R:"11110/10001/10001/11110/10100/10010/10001",S:"01111/10000/10000/01110/00001/00001/11110",T:"11111/00100/00100/00100/00100/00100/00100",U:"10001/10001/10001/10001/10001/10001/01110",V:"10001/10001/10001/10001/10001/01010/00100",W:"10001/10001/10001/10101/10101/10101/01010",X:"10001/10001/01010/00100/01010/10001/10001",Y:"10001/10001/01010/00100/00100/00100/00100",Z:"11111/00001/00010/00100/01000/10000/11111",
  "0":"01110/10001/10011/10101/11001/10001/01110","1":"00100/01100/00100/00100/00100/00100/01110","2":"01110/10001/00001/00010/00100/01000/11111","3":"11110/00001/00001/01110/00001/00001/11110","4":"00010/00110/01010/10010/11111/00010/00010","5":"11111/10000/10000/11110/00001/00001/11110","6":"01110/10000/10000/11110/10001/10001/01110","7":"11111/00001/00010/00100/01000/01000/01000","8":"01110/10001/10001/01110/10001/10001/01110","9":"01110/10001/10001/01111/00001/00001/01110",
  "!":"00100/00100/00100/00100/00100/00000/00100","?":"01110/10001/00001/00010/00100/00000/00100",".":"00000/00000/00000/00000/00000/00110/00110",":":"00000/00110/00110/00000/00110/00110/00000","-":"00000/00000/00000/11111/00000/00000/00000","/":"00001/00010/00010/00100/01000/01000/10000","'":"00100/00100/00010/00000/00000/00000/00000","(":"00010/00100/01000/01000/01000/00100/00010",")":"01000/00100/00010/00010/00010/00100/01000",">":"10000/01000/00100/00010/00100/01000/10000","*":"00100/10101/01110/11111/01110/10101/00100","=":"00000/11111/00000/11111/00000/00000/00000"
};
function text(s,x,y,color="#fff",align="left",size=8){const str=String(s).toUpperCase().replaceAll("×","X").replaceAll("★","*").replaceAll("◉","O").replaceAll("◆","D"),scale=size>=17?3:size>=10?2:1,width=Math.max(0,(str.length*6-1)*scale);let sx=align==="center"?x-width/2:align==="right"?x-width:x;const paint=(ox,oy,c)=>{ctx.fillStyle=c;for(let i=0;i<str.length;i++){const rows=(FONT5[str[i]]||FONT5["?"]).split("/");for(let r=0;r<7;r++)for(let q=0;q<5;q++)if(rows[r][q]==="1")ctx.fillRect(Math.round(sx+i*6*scale+q*scale+ox),Math.round(y+r*scale+oy),scale,scale)}};paint(1,1,"#1b1830");paint(0,0,color)}
function panel(x,y,w,h,a=.86){ctx.fillStyle=`rgba(15,12,32,${a})`;ctx.fillRect(x,y,w,h);ctx.strokeStyle="#fff3";ctx.strokeRect(x+.5,y+.5,w-1,h-1)}
function render(){if(game.mode==="title")drawTitle();else if(game.mode==="map")drawMap();else if(game.mode==="gameover")drawGameOver();else if(game.mode==="ending")drawEnding();else{drawLevel();if(game.mode==="pause")drawPause();if(game.mode==="death")drawDeath();if(game.mode==="clear")drawClear()}if(game.transition>0){ctx.fillStyle=`rgba(0,0,0,${game.transition/24})`;ctx.fillRect(0,0,W,H)}}
function drawTitle(){background("grass",game.tick*.12,PAL.grass);ctx.fillStyle="#18325244";ctx.fillRect(0,0,W,H);text("SUPER MARIO WORLD",128,25,"#fff6a8","center",15);text("YOSHI'S ISLAND 1",128,49,"#ffcf58","center",13);drawMario({x:116,y:87,w:12,h:27,power:"cape",facing:1,inv:0,yoshi:null,spinT:0,anim:game.tick},0);text("ONE PLAYER GAME",128,125,"#fff","center",7);panel(62,145,132,46,.9);const has=!!localStorage.getItem(SAVE_KEY);text((game.titleChoice?"  ":"> ")+(has?"CONTINUE":"START GAME"),81,155,game.titleChoice?"#fff":"#ffe46b");text((game.titleChoice?"> ":"  ")+"NEW GAME / RESET",81,173,game.titleChoice?"#ffe46b":"#fff");text("ENTER TO SELECT",128,204,"#fff","center",7)}
function hill(x,y,w,c){ctx.fillStyle=c;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+w/2,y-w*.45);ctx.lineTo(x+w,y);ctx.fill()}
function drawMap(){ctx.fillStyle="#66b8e6";ctx.fillRect(0,0,W,H);for(let y=0;y<H;y+=8){ctx.fillStyle=y%16?"#5ba9db":"#6bc2e8";ctx.fillRect(0,y,W,8)}ctx.fillStyle="#66b95b";blob(18,68,170,116);ctx.fillStyle="#d6c35f";blob(143,38,102,86);ctx.fillStyle="#474055";blob(184,31,62,74);ctx.lineWidth=4;ctx.lineCap="round";for(const [id,n]of Object.entries(NODES))for(const dest of n.edges){if(id>dest)continue;const q=NODES[dest],open=accessible(id)&&accessible(dest);ctx.strokeStyle=open?"#f6e08a":"#314b65";ctx.setLineDash(open?[]:[3,4]);ctx.beginPath();ctx.moveTo(n.x,n.y);ctx.lineTo(q.x,q.y);ctx.stroke()}ctx.setLineDash([]);for(const [id,n]of Object.entries(NODES)){const open=accessible(id),done=game.save.exits[id];ctx.fillStyle=!open?"#30455e":id==="castle"?"#6d4250":id==="switch"?"#e8b840":"#f2dc87";ctx.beginPath();ctx.arc(n.x,n.y,id==="castle"?10:7,0,Math.PI*2);ctx.fill();ctx.strokeStyle=done?"#fff":"#26334a";ctx.lineWidth=2;ctx.stroke();if(done?.secret){ctx.fillStyle="#ef6ad0";ctx.fillRect(n.x+5,n.y-9,4,4)}}let pos=NODES[game.node];if(game.mapTarget){const q=NODES[game.mapTarget],t=game.mapT/18;pos={x:pos.x+(q.x-pos.x)*t,y:pos.y+(q.y-pos.y)*t}}mapMario(pos.x,pos.y-14);panel(13,9,230,28,.78);text(NODES[game.node].name,128,15,"#fff3ad","center",9);text("ENTER: PLAY   N: NEW GAME",128,29,"#ded9ef","center",6);panel(8,198,240,18,.75);text(`MARIO × ${game.save.lives}`,14,203,"#fff",undefined,7);text(`★ ${game.save.stars}`,104,203,"#ffe371",undefined,7);text(`◉ ${String(game.save.coins).padStart(2,"0")}`,151,203,"#ffe371",undefined,7);text(String(game.save.score).padStart(7,"0"),242,203,"#fff","right",7)}
function blob(x,y,w,h){ctx.beginPath();ctx.ellipse(x+w*.25,y+h*.5,w*.34,h*.54,0,0,Math.PI*2);ctx.ellipse(x+w*.66,y+h*.48,w*.42,h*.47,0,0,Math.PI*2);ctx.fill()}function mapMario(x,y){ctx.fillStyle="#e93d3d";ctx.fillRect(x-4,y,9,4);ctx.fillStyle="#f4b46d";ctx.fillRect(x-3,y+4,7,5);ctx.fillStyle="#3059b5";ctx.fillRect(x-4,y+9,9,6);ctx.fillStyle="#fff";ctx.fillRect(x+2,y+5,2,2)}
function drawLevel(){if(!game.level)return;const l=game.level,a=l.area,cam=game.camera.x,p=PAL[a.theme];background(a.theme,cam,p);ctx.save();ctx.translate(-Math.floor(cam),-Math.floor(game.camera.y));const c0=Math.max(0,Math.floor(cam/T)-1),c1=Math.min(a.w-1,Math.ceil((cam+W)/T)+1);for(let r=0;r<a.h;r++)for(let c=c0;c<=c1;c++){const t=tileAt(a,c,r);if(t)(a.theme==="grass"||a.theme==="house"?drawTileSMW(t,c*T,r*T,c,r):drawTile(t,c*T,r*T,p,a.theme,c,r))}for(const [k,n]of a.turning){const [c,r]=k.split(",").map(Number);if(c>=c0&&c<=c1)drawTurningBlock(c*T,r*T,n)}for(const q of a.livePlatforms)drawPlatform(q,p);for(const o of a.liveObjects)if(o.alive&&(o.type==="bush"||o.type==="fence"))drawDecor(o);for(const o of a.liveObjects)if(o.alive&&o.type!=="bush"&&o.type!=="fence")(a.theme==="grass"?drawGrassObject(o):drawObject(o));for(const e of a.liveEnemies)if(e.alive&&e.active)(a.theme==="grass"?drawGrassEnemySMW(e):drawEnemy(e));drawMario(game.player,0);ctx.restore();drawHud();if(game.messageTick>0)drawMessage(game.message);if(game.debug)drawDebug()}
function drawTurningBlock(x,y,n){const w=Math.max(2,Math.round(14*Math.abs(Math.sin(n*.18))));ctx.fillStyle="#161c25";ctx.fillRect(x+8-Math.ceil(w/2),y,w,16);ctx.fillStyle="#e79a3c";ctx.fillRect(x+8-Math.floor(w/2),y+1,Math.max(1,w-1),14)}
function background(theme,cam,p){ctx.fillStyle=p.sky;ctx.fillRect(0,0,W,H);if(theme==="grass"||theme==="house"){const shift=Math.floor(cam*.08)%78;for(let i=-1;i<5;i++){const w=50+(i&1)*18,h=116+(i%3+1)*17;smwDome(i*78-shift,193,w,h,i&1?"#9bd7e8":"#83c1dc")}cloudBand(-18-(Math.floor(cam*.18)%130),72,82);cloudBand(133-(Math.floor(cam*.18)%145),102,74);cloudBand(238-(Math.floor(cam*.18)%160),57,90);return}if(theme==="cave"||theme==="castle"){for(let i=0;i<22;i++){const x=(i*43-Math.floor(cam*.12))%290-20,y=34+i*37%150;ctx.fillStyle=i%2?p.far:"#ffffff0b";ctx.fillRect(x,y,5+i%3*3,18+i%5*5)}if(theme==="castle"){ctx.fillStyle="#ec6639";ctx.fillRect(0,184,W,40);for(let i=0;i<22;i++){ctx.fillStyle=i%2?"#ffb43c":"#e63c36";ctx.fillRect(i*15-game.tick%15,184+(i+game.tick/6)%3*3,10,4)}}return}if(theme==="water"){for(let y=55;y<H;y+=8){ctx.fillStyle=y%16?"#2d8bb599":"#53bccc66";ctx.fillRect(0,y,W,8)}for(let i=0;i<18;i++){ctx.fillStyle="#c9fbff66";ctx.fillRect((i*29-game.tick*.15)%280,65+i*23%130,2,2)}return}for(let i=0;i<7;i++)cloud((i*61-Math.floor(cam*.18))%360-50,72+i%3*16);for(let i=0;i<5;i++)hill(i*82-Math.floor(cam*.28)%82-40,178,74,p.far)}
function smwDome(x,base,w,h,c){ctx.fillStyle="#4c7f9d";ctx.fillRect(Math.floor(x+5),Math.floor(base-h+w/2+3),w,Math.ceil(h-w/2));ctx.beginPath();ctx.arc(Math.floor(x+w/2+5),Math.floor(base-h+w/2+3),w/2,Math.PI,0);ctx.fill();ctx.fillStyle=c;ctx.fillRect(Math.floor(x),Math.floor(base-h+w/2),w,Math.ceil(h-w/2));ctx.beginPath();ctx.arc(Math.floor(x+w/2),Math.floor(base-h+w/2),w/2,Math.PI,0);ctx.fill();ctx.fillStyle="#dff4ed";ctx.fillRect(Math.floor(x+w*.3),Math.floor(base-h+w*.42),6,14);ctx.fillRect(Math.floor(x+w*.27),Math.floor(base-h+w*.48),12,5);ctx.fillStyle="#6aa5c2";for(let y=Math.floor(base-h+w*.45);y<base;y+=4)ctx.fillRect(Math.floor(x+w-5),y,2,2)}
function cloudBand(x,y,w){ctx.fillStyle="#eaf8f2";ctx.fillRect(x,y,w,13);ctx.fillRect(x+8,y-4,w-19,21);ctx.fillStyle="#b8dfe2";ctx.fillRect(x+6,y+13,w-12,3);for(let i=0;i<w;i+=6)ctx.fillRect(x+i,y+10+(i/6%2),3,2)}
function smwHill(x,base,w,h,c){ctx.fillStyle=c;ctx.beginPath();ctx.moveTo(x,base);ctx.quadraticCurveTo(x+w*.15,base-h*.82,x+w*.42,base-h);ctx.quadraticCurveTo(x+w*.72,base-h*.82,x+w,base);ctx.fill();ctx.fillStyle="#3f9850";for(let i=0;i<5;i++){const px=Math.floor(x+12+(i*17)%Math.max(18,w-20)),py=Math.floor(base-h*.55+(i%3)*14);ctx.fillRect(px,py,4,7);ctx.fillRect(px-1,py+2,6,3)}ctx.fillStyle="#d8f09a";ctx.fillRect(Math.floor(x+w*.39),Math.floor(base-h+7),3,4)}
function backBush(x,base,s,c){ctx.fillStyle=c;ctx.beginPath();ctx.arc(x+s*.22,base-s*.33,s*.23,Math.PI,0);ctx.arc(x+s*.52,base-s*.5,s*.3,Math.PI,0);ctx.arc(x+s*.82,base-s*.3,s*.22,Math.PI,0);ctx.lineTo(x+s,base);ctx.lineTo(x,base);ctx.fill();ctx.fillStyle="#246f42";ctx.fillRect(Math.floor(x+s*.36),Math.floor(base-s*.38),2,4);ctx.fillRect(Math.floor(x+s*.68),Math.floor(base-s*.3),2,4)}
function cloud(x,y,v=0){ctx.fillStyle="#e8fbff";ctx.fillRect(x+3,y+7,38,10);ctx.fillRect(x+9,y+3,12,14);ctx.fillRect(x+21,y+(v?1:4),13,15);ctx.fillStyle="#a9e4ee";ctx.fillRect(x+3,y+15,38,3);ctx.fillRect(x+7,y+12,4,3);ctx.fillStyle="#fff";ctx.fillRect(x+11,y+4,8,3);ctx.fillRect(x+24,y+3,7,3)}
function drawTile(t,x,y,p,theme,c,r){if(t==="L"){ctx.fillStyle="#f04b24";ctx.fillRect(x,y,T,T);ctx.fillStyle="#ffc52f";for(let i=0;i<3;i++)ctx.fillRect(x+i*6,y+(game.tick/5+i)%5,5,3);return}if(t==="/"||t==="\\"){ctx.fillStyle=p.ground;ctx.beginPath();ctx.moveTo(x,t==="/"?y+T:y);ctx.lineTo(x+T,t==="/"?y:y+T);ctx.lineTo(x+T,y+T);ctx.fill();return}if((theme==="grass"||theme==="house")&&(t==="G"||t==="F")){const top=t==="F"||!solid(tileAt(game.level.area,c,r-1));ctx.fillStyle="#b85b2f";ctx.fillRect(x,y,T,T);ctx.fillStyle="#d67a39";ctx.fillRect(x+2,y+2,T-4,T-4);ctx.fillStyle="#8d412c";if(hash(c,r)>.45){ctx.fillRect(x+5,y+8,3,2);ctx.fillRect(x+10,y+12,2,2)}else{ctx.fillRect(x+3,y+12,2,2);ctx.fillRect(x+11,y+6,3,2)}ctx.fillStyle="#ed9a45";ctx.fillRect(x+3,y+5,2,2);if(top){ctx.fillStyle="#267b3e";ctx.fillRect(x,y,T,5);ctx.fillStyle="#55b947";ctx.fillRect(x,y,T,3);ctx.fillStyle="#8bd850";ctx.fillRect(x+2,y,T-4,2);for(let i=0;i<4;i++)ctx.fillRect(x+i*4,y+3+(i+c)%2,3,2)}if(t==="F"){ctx.fillStyle="#75352a";ctx.fillRect(x,y+14,T,2);ctx.fillStyle="#53a83f";ctx.fillRect(x+(c%2?2:11),y+14,3,2)}return}if(t==="Q"){ctx.fillStyle="#c56e22";ctx.fillRect(x,y,T,T);ctx.fillStyle="#f3ad32";ctx.fillRect(x+1,y+1,14,14);ctx.fillStyle="#ffd35a";ctx.fillRect(x+3,y+2,10,2);ctx.fillStyle="#7a431f";ctx.fillRect(x+7,y+4,3,2);ctx.fillRect(x+9,y+6,2,4);ctx.fillRect(x+7,y+10,2,2);ctx.fillRect(x+2,y+2,2,2);ctx.fillRect(x+12,y+12,2,2);return}if(t==="B"||t==="X"){ctx.fillStyle=t==="X"?"#5f6165":"#9a4e2c";ctx.fillRect(x,y,T,T);ctx.fillStyle=t==="X"?"#989b9b":"#e08a39";ctx.fillRect(x+1,y+1,14,14);ctx.fillStyle=t==="X"?"#c9cfca":"#ffc05a";ctx.fillRect(x+3,y+3,10,2);ctx.fillStyle=t==="X"?"#555b5d":"#a7582b";ctx.fillRect(x+4,y+6,8,7);ctx.fillStyle=t==="X"?"#858b89":"#e89a45";ctx.fillRect(x+5,y+7,6,4);return}if("pPvV".includes(t)){const blue=t==="v"||t==="V",top=t==="p"||t==="v";ctx.fillStyle=blue?"#182763":"#155c36";ctx.fillRect(x,y,T,T);ctx.fillStyle=blue?"#2858b6":"#2e9f45";ctx.fillRect(x+2,y,T-4,T);ctx.fillStyle=blue?"#77a8ed":"#73db5b";ctx.fillRect(x+4,y,4,T);if(top){ctx.fillStyle=blue?"#14245b":"#176835";ctx.fillRect(x,y,32,5);ctx.fillStyle=blue?"#3b70cf":"#42bb4d";ctx.fillRect(x+2,y+1,28,3);ctx.fillStyle=blue?"#9dc4f5":"#91e66a";ctx.fillRect(x+5,y+1,7,2)}return}const colors={W:"#9b663f",C:"#f5f4e8",R:"#68507c",K:"#3a8b82",Y:"#d49a36",S:"#695762",D:"#8a6a9a",U:"#c88f36"};ctx.fillStyle=colors[t]||p.ground;ctx.fillRect(x,y,T,T);ctx.fillStyle=p.edge;ctx.fillRect(x,y,T,2);ctx.fillStyle="#0003";ctx.fillRect(x+14,y,2,T)}
function drawTileSMW(t,x,y,c,r){if(t==="/"||t==="\\"){for(let i=0;i<16;i++){const sy=t==="/"?15-i:i;ctx.fillStyle="#171c25";ctx.fillRect(x+i,y+sy,1,1);ctx.fillStyle="#17d135";ctx.fillRect(x+i,y+sy+1,1,Math.min(3,15-sy));ctx.fillStyle="#d5ad61";ctx.fillRect(x+i,y+Math.min(16,sy+4),1,Math.max(0,12-sy))}ctx.fillStyle="#f2d06b";ctx.fillRect(x+(c*3%11),y+12,2,3);return}if(t==="G"||t==="F"){const top=t==="F"||!tileAt(game.level.area,c,r-1);ctx.fillStyle="#d3aa5e";ctx.fillRect(x,y,16,16);ctx.fillStyle="#f2cc66";const n=hash(c,r);ctx.fillRect(x+2+Math.floor(n*8),y+7,2,4);ctx.fillRect(x+10-Math.floor(n*5),y+12,2,3);if(top){ctx.fillStyle="#151c23";ctx.fillRect(x,y,16,2);ctx.fillStyle="#08762d";ctx.fillRect(x,y+2,16,4);ctx.fillStyle="#17d437";ctx.fillRect(x+1,y+2,14,2);for(let i=0;i<4;i++)ctx.fillRect(x+i*4,y+5,2,1)}if(t==="F"){ctx.fillStyle="#151c23";ctx.fillRect(x,y+15,16,1);ctx.fillRect(x,y,1,16);ctx.fillRect(x+15,y,1,16)}return}if("pPvV".includes(t)){const blue=t==="v"||t==="V",top=t==="p"||t==="v";ctx.fillStyle="#121b24";ctx.fillRect(x,y,16,16);ctx.fillStyle=blue?"#244db2":"#087a37";ctx.fillRect(x+1,y+1,14,15);ctx.fillStyle=blue?"#427cdd":"#21c542";ctx.fillRect(x+3,y+1,9,15);ctx.fillStyle=blue?"#a2c8f5":"#8aef65";ctx.fillRect(x+4,y+1,3,14);if(top){ctx.fillStyle="#151b24";ctx.fillRect(x,y,16,2);ctx.fillRect(x,y,2,7);ctx.fillRect(x+14,y,2,7);ctx.fillStyle=blue?"#4b85e6":"#25c943";ctx.fillRect(x+2,y+2,12,5);ctx.fillStyle=blue?"#b4d5f8":"#92ef69";ctx.fillRect(x+4,y+2,4,4)}return}drawTile(t,x,y,PAL.grass,"grass",c,r)}
function drawPlatform(q,p){ctx.fillStyle=p.edge;ctx.fillRect(q.x,q.y,q.w,q.h);ctx.fillStyle="#fff6";ctx.fillRect(q.x,q.y,q.w,2)}
function drawDecor(o){const x=o.x,y=o.y;if(o.type==="bush"){ctx.fillStyle="#14202a";ctx.beginPath();ctx.moveTo(x,y+32);ctx.lineTo(x+4,y+21);ctx.lineTo(x+8,y+18);ctx.lineTo(x+10,y+11);ctx.lineTo(x+16,y+14);ctx.lineTo(x+20,y+7);ctx.lineTo(x+25,y+13);ctx.lineTo(x+30,y+10);ctx.lineTo(x+33,y+18);ctx.lineTo(x+39,y+21);ctx.lineTo(x+42,y+32);ctx.fill();ctx.fillStyle=o.variant?"#20bd37":"#18d431";ctx.beginPath();ctx.moveTo(x+3,y+31);ctx.lineTo(x+7,y+22);ctx.lineTo(x+11,y+20);ctx.lineTo(x+12,y+14);ctx.lineTo(x+17,y+17);ctx.lineTo(x+20,y+11);ctx.lineTo(x+24,y+17);ctx.lineTo(x+29,y+14);ctx.lineTo(x+31,y+21);ctx.lineTo(x+37,y+23);ctx.lineTo(x+39,y+31);ctx.fill();ctx.fillStyle="#f5f5d8";ctx.fillRect(x+11,y+22,3,3);ctx.fillRect(x+12,y+21,1,5);ctx.fillRect(x+10,y+23,5,1);ctx.fillStyle="#f08b45";ctx.fillRect(x+27,y+24,3,3)}else{ctx.fillStyle="#6d3c28";ctx.fillRect(x+2,y+7,3,25);ctx.fillRect(x+27,y+7,3,25);ctx.fillStyle="#d9984e";ctx.fillRect(x,y+12,32,4);ctx.fillRect(x,y+23,32,4);ctx.fillStyle="#f0bb68";ctx.fillRect(x+1,y+12,30,1)}}
function mushroom(x,y,c){ctx.fillStyle=c;ctx.fillRect(x+1,y+2,12,7);ctx.fillRect(x+3,y,8,2);ctx.fillStyle="#fff0cf";ctx.fillRect(x+3,y+9,8,5);ctx.fillStyle="#292239";ctx.fillRect(x+5,y+10,1,2);ctx.fillRect(x+9,y+10,1,2)}function flower(x,y){ctx.fillStyle="#f05443";ctx.fillRect(x+2,y+1,10,9);ctx.fillStyle="#ffe16a";ctx.fillRect(x+5,y+3,4,4);ctx.fillStyle="#52b858";ctx.fillRect(x+6,y+10,2,5)}function cape(x,y){ctx.fillStyle="#f5d344";ctx.fillRect(x+2,y+1,10,13);ctx.fillStyle="#e69638";ctx.fillRect(x+8,y+3,4,8);ctx.fillStyle="#fff3a0";ctx.fillRect(x+3,y+2,2,8)}
function drawObject(o){const x=o.x,y=o.y;if(o.type==="coin"){ctx.fillStyle="#ffe05c";ctx.fillRect(x+4,y,4,12);ctx.fillStyle="#fff5a4";ctx.fillRect(x+5,y+2,1,7)}else if(o.type==="dragon"){ctx.fillStyle="#ffd84e";ctx.fillRect(x+1,y+2,10,10);ctx.fillStyle="#f38b31";ctx.fillRect(x+3,y,6,14);ctx.fillStyle="#fff0a2";ctx.fillRect(x+5,y+3,2,6)}else if(o.type==="oneup")mushroom(x,y,"#52c85c");else if(o.type==="power"){if(o.kind==="cape")cape(x,y);else if(o.kind==="fire")flower(x,y);else mushroom(x,y,"#e94848")}else if(o.type==="midpoint"){ctx.fillStyle=o.hit?"#fff":"#ed3d45";ctx.fillRect(x+6,y-18,2,50);ctx.fillStyle=o.hit?"#4cda74":"#f5d74f";ctx.fillRect(x+8,y-14,10,12)}else if(o.type==="goal"){ctx.fillStyle="#f4e8c0";ctx.fillRect(x+6,y,2,o.h);const gy=y+8+(Math.sin(game.tick/28)+1)*(o.h-30)/2;ctx.fillStyle="#f5d348";ctx.fillRect(x,gy,14,4)}else if(o.type==="key"){ctx.fillStyle="#ffe26b";ctx.fillRect(x,y+4,12,4);ctx.fillRect(x+8,y,4,10);ctx.fillRect(x+1,y+1,5,10);ctx.fillStyle="#5c4828";ctx.fillRect(x+2,y+3,2,4)}else if(o.type==="keyhole"){ctx.fillStyle="#343047";ctx.fillRect(x-2,y-2,16,18);ctx.fillStyle="#e9c34c";ctx.fillRect(x+4,y+4,5,9)}else if(o.type==="pswitch"){ctx.fillStyle="#4b65dc";ctx.fillRect(x,y+6,15,8);text("P",x+7,y+6,"#fff","center",7)}else if(o.type==="palaceSwitch"){ctx.fillStyle="#e9b73e";ctx.fillRect(x-5,y+5,22,9);ctx.fillStyle="#fff19a";ctx.fillRect(x-2,y,16,8)}else if(o.type==="yoshi")drawYoshi(o);else if(o.type==="message"){ctx.fillStyle="#805937";ctx.fillRect(x+2,y,10,18);ctx.fillStyle="#f7df8c";ctx.fillRect(x,y,14,9);text("!",x+7,y+1,"#6a3b2a","center",7)}else if(o.type==="fireball"){ctx.fillStyle="#fff17a";ctx.fillRect(x,y,7,7);ctx.fillStyle="#ef5938";ctx.fillRect(x+2,y+2,4,4)}else if(o.type==="bossExit"){ctx.fillStyle="#7ce77b";ctx.fillRect(x,y,14,28);ctx.fillStyle="#fff";ctx.fillRect(x+4,y+5,6,10)}}
function drawGrassObject(o){const x=Math.floor(o.x),y=Math.floor(o.y);if(o.type==="flyingPrize"){const wing=Math.floor(game.tick/5)%2;ctx.fillStyle="#f2f4e8";ctx.fillRect(x-7,y+5+wing,7,5);ctx.fillRect(x+16,y+5+(1-wing),7,5);ctx.fillStyle="#9bc7db";ctx.fillRect(x-6,y+9+wing,5,2);ctx.fillRect(x+17,y+9+(1-wing),5,2);drawTile(o.used?"X":"Q",x,y,PAL.grass,"grass",0,0);return}if(o.type==="slopePipe"){ctx.save();ctx.translate(x,y+42);ctx.rotate(-Math.PI/4);ctx.fillStyle="#14202a";ctx.fillRect(-2,-3,54,24);ctx.fillStyle="#09813b";ctx.fillRect(0,0,52,18);ctx.fillStyle="#27cb47";ctx.fillRect(2,1,48,8);ctx.fillStyle="#a0ef6e";ctx.fillRect(6,1,6,16);ctx.fillStyle="#17202a";ctx.fillRect(43,-4,9,26);ctx.fillStyle="#32d64d";ctx.fillRect(44,-2,7,22);ctx.restore();return}if(o.type==="dragon"){ctx.fillStyle="#9e6423";ctx.fillRect(x+3,y-4,8,22);ctx.fillRect(x+1,y,12,14);ctx.fillStyle="#f7c82e";ctx.fillRect(x+3,y-3,8,20);ctx.fillRect(x+2,y+1,10,12);ctx.fillStyle="#ffe86a";ctx.fillRect(x+5,y-1,3,16);ctx.fillStyle="#c98220";ctx.fillRect(x+8,y+3,2,3);ctx.fillRect(x+6,y+9,4,2);return}if(o.type==="coin"){ctx.fillStyle="#a86921";ctx.fillRect(x+4,y,5,13);ctx.fillStyle="#ffd53c";ctx.fillRect(x+3,y+2,7,9);ctx.fillStyle="#fff080";ctx.fillRect(x+5,y+3,2,7);return}if(o.type==="midpoint"){ctx.fillStyle="#f6ead0";ctx.fillRect(x+7,y-20,2,52);ctx.fillStyle="#d93742";ctx.fillRect(x+9,y-16,13,11);ctx.fillStyle="#f6d84a";ctx.fillRect(x+11,y-14,8,7);return}if(o.type==="goal"){ctx.fillStyle="#f6ead0";ctx.fillRect(x+7,y,2,o.h);ctx.fillStyle="#d3d7d1";ctx.fillRect(x+4,y-2,8,3);const gy=y+7+(Math.sin(game.tick/28)+1)*(o.h-28)/2;ctx.fillStyle="#f4d43c";ctx.fillRect(x-2,gy,18,4);ctx.fillStyle="#fff4a0";ctx.fillRect(x,gy,14,1);return}drawObject(o)}
function drawEnemy(e){const x=Math.floor(e.x),y=Math.floor(e.y);if(e.type.startsWith("koopa")){if(e.state==="shell"){ctx.fillStyle=e.type==="koopaRed"?"#df4848":"#48ae58";ctx.fillRect(x,y+3,14,10);ctx.fillStyle="#f7df99";ctx.fillRect(x+4,y+6,6,5)}else{ctx.fillStyle="#f2d57e";ctx.fillRect(x+3,y,8,12);ctx.fillStyle=e.type==="koopaRed"?"#d74246":"#43a756";ctx.fillRect(x,y+9,13,11);ctx.fillStyle="#fff";ctx.fillRect(x+7,y+2,3,3)}}else if(e.type==="galoomba"){ctx.fillStyle="#875132";ctx.fillRect(x+1,y+2,12,11);ctx.fillStyle="#e8b76f";ctx.fillRect(x+3,y+6,8,5);ctx.fillStyle="#222";ctx.fillRect(x+3,y+4,2,2);ctx.fillRect(x+9,y+4,2,2)}else if(e.type==="rex"){ctx.fillStyle=e.hp>1?"#7358bf":"#9275d5";ctx.fillRect(x+3,y,12,e.h);ctx.fillRect(x,y+6,18,8);ctx.fillStyle="#fff";ctx.fillRect(x+11,y+3,3,3)}else if(e.type==="piranha"){ctx.fillStyle="#45a84c";ctx.fillRect(x+6,y+8,3,14);ctx.fillStyle="#e3444c";ctx.fillRect(x,y,14,11);ctx.fillStyle="#fff";ctx.fillRect(x+2,y+2,3,3)}else if(e.type==="bullet"){ctx.fillStyle="#2a2934";ctx.fillRect(x,y+2,16,9);ctx.fillStyle="#fff";ctx.fillRect(x+3,y+3,3,3)}else if(e.type==="boo"){ctx.fillStyle="#f5f1e5";ctx.fillRect(x+2,y,12,15);ctx.fillRect(x,y+3,16,8);ctx.fillStyle="#5b405a";ctx.fillRect(x+4,y+4,2,4);ctx.fillRect(x+10,y+4,2,4)}else if(e.type==="fish"){ctx.fillStyle="#ef8d43";ctx.fillRect(x+2,y+2,12,9);ctx.fillRect(x,y+5,4,5);ctx.fillStyle="#fff";ctx.fillRect(x+10,y+3,2,2)}else if(e.type==="lavaBubble"){ctx.fillStyle="#ffdb43";ctx.fillRect(x+2,y,8,12);ctx.fillStyle="#ed4d32";ctx.fillRect(x,y+3,12,6)}else if(e.type==="crusher"){ctx.fillStyle="#756879";ctx.fillRect(x,y,e.w,e.h);ctx.fillStyle="#a898a9";ctx.fillRect(x+3,y+3,e.w-6,5);ctx.fillStyle="#251f2e";ctx.fillRect(x+5,y+17,5,5);ctx.fillRect(x+18,y+17,5,5)}else if(e.type==="iggy"){ctx.fillStyle="#66b74a";ctx.fillRect(x+2,y+5,16,20);ctx.fillStyle="#f0cf75";ctx.fillRect(x,y+11,20,9);ctx.fillStyle="#e74c53";for(let i=0;i<3;i++)ctx.fillRect(x+3+i*5,y+i%2*2,3,7);ctx.fillStyle="#fff";ctx.fillRect(x+13,y+8,3,3)}}
function drawGrassEnemySMW(e){const x=Math.floor(e.x),y=Math.floor(e.y);if(e.type==="slidingKoopa"){ctx.fillStyle="#17202a";ctx.fillRect(x+1,y+18,13,4);ctx.fillStyle="#e6ae4f";ctx.fillRect(x+4,y+5,8,14);ctx.fillStyle="#f6d172";ctx.fillRect(x+7,y+2,7,9);ctx.fillStyle="#fff";ctx.fillRect(x+10,y+3,3,3);ctx.fillStyle="#253a90";ctx.fillRect(x+1,y+13,12,7);ctx.fillStyle="#6f9ae5";ctx.fillRect(x+3,y+14,7,3);return}if(e.type==="banzai"){ctx.fillStyle="#e5e8df";ctx.fillRect(x+4,y+2,23,24);ctx.fillStyle="#121820";ctx.fillRect(x,y+4,26,20);ctx.fillRect(x+5,y,19,28);ctx.fillStyle="#fff";ctx.fillRect(x+4,y+6,8,8);ctx.fillStyle="#222";ctx.fillRect(x+7,y+9,4,4);ctx.fillStyle="#db4550";ctx.fillRect(x+5,y+18,16,7);ctx.fillStyle="#fff3cf";ctx.fillRect(x+7,y+17,3,4);ctx.fillRect(x+16,y+17,3,4);ctx.fillStyle="#9da6a2";ctx.fillRect(x+27,y+3,5,22);return}if(e.type==="chuck"){ctx.fillStyle="#17202a";ctx.fillRect(x+2,y+24,7,4);ctx.fillRect(x+12,y+24,7,4);ctx.fillStyle="#258645";ctx.fillRect(x+2,y+8,16,17);ctx.fillStyle="#f1f0dd";ctx.fillRect(x+5,y+7,10,17);ctx.fillStyle="#58bd61";ctx.fillRect(x+7,y+10,6,10);ctx.fillStyle="#f0b465";ctx.fillRect(x+7,y+3,9,7);ctx.fillStyle="#fff";ctx.fillRect(x+4,y,13,5);ctx.fillStyle="#318e47";ctx.fillRect(x+7,y,8,3);ctx.fillStyle="#20242a";ctx.fillRect(x+13,y+5,2,2);return}if(e.type==="koopaBlue"){const spin=Math.floor(game.tick/2)%2;ctx.fillStyle="#131923";ctx.fillRect(x+1,y+8,13,5);ctx.fillStyle="#2855b9";ctx.fillRect(x+2,y+2,11,10);ctx.fillStyle="#5486e0";ctx.fillRect(x+3,y+2,8,3);ctx.fillStyle="#f0c85c";ctx.fillRect(x+5,y+5,5,6);ctx.fillStyle="#fff49a";ctx.fillRect(x+(spin?4:6),y+3,5,2);ctx.fillStyle="#70432d";ctx.fillRect(x,y+11,15,2);return}drawGrassEnemy(e)}
function drawGrassEnemy(e){const x=Math.floor(e.x),y=Math.floor(e.y),walk=Math.floor(game.tick/8+e.id)%2;if(e.type==="galoomba"){ctx.fillStyle="#3c241d";ctx.fillRect(x+2,y+2,12,10);ctx.fillStyle="#9d532f";ctx.fillRect(x+1,y+4,14,7);ctx.fillRect(x+4,y,8,13);ctx.fillStyle="#e6a35b";ctx.fillRect(x+4,y+6,8,5);ctx.fillStyle="#fff";ctx.fillRect(x+4,y+4,3,3);ctx.fillRect(x+10,y+4,3,3);ctx.fillStyle="#20191b";ctx.fillRect(x+5,y+5,1,2);ctx.fillRect(x+11,y+5,1,2);ctx.fillStyle="#4c2920";ctx.fillRect(x+(walk?1:3),y+12,5,2);ctx.fillRect(x+(walk?10:8),y+12,5,2);return}if(e.type.startsWith("koopa")){const shell=e.type==="koopaRed"?"#d93b3e":"#2fa44d";if(e.state==="shell"){ctx.fillStyle="#542b25";ctx.fillRect(x+1,y+9,13,4);ctx.fillStyle=shell;ctx.fillRect(x+2,y+2,11,10);ctx.fillStyle="#f2c95f";ctx.fillRect(x+5,y+5,5,5);ctx.fillStyle="#fff58a";ctx.fillRect(x+4,y+3,5,2)}else{ctx.fillStyle="#e0a94f";ctx.fillRect(x+4,y,8,13);ctx.fillStyle="#f6d277";ctx.fillRect(x+7,y+1,7,8);ctx.fillStyle="#fff";ctx.fillRect(x+10,y+2,3,3);ctx.fillStyle="#242027";ctx.fillRect(x+12,y+3,1,2);ctx.fillStyle=shell;ctx.fillRect(x+1,y+9,12,10);ctx.fillStyle="#f4d46e";ctx.fillRect(x+4,y+12,6,5);ctx.fillStyle="#80522c";ctx.fillRect(x+(walk?0:2),y+21,6,3);ctx.fillRect(x+(walk?9:7),y+21,6,3)}return}if(e.type==="rex"){ctx.fillStyle="#49326e";ctx.fillRect(x+2,y+4,16,16);ctx.fillStyle=e.hp>1?"#8457b8":"#a16ac9";ctx.fillRect(x+1,y+6,17,11);ctx.fillRect(x+5,y,10,22);ctx.fillStyle="#d6a55d";ctx.fillRect(x+5,y+12,9,8);ctx.fillStyle="#fff";ctx.fillRect(x+11,y+3,4,4);ctx.fillStyle="#222";ctx.fillRect(x+13,y+4,1,2);return}if(e.type==="piranha"){ctx.fillStyle="#217c3e";ctx.fillRect(x+6,y+8,4,14);ctx.fillStyle="#38a64b";ctx.fillRect(x+2,y+13,7,4);ctx.fillRect(x+8,y+17,6,3);ctx.fillStyle="#d83c46";ctx.fillRect(x+1,y+1,12,10);ctx.fillRect(x+3,y,9,12);ctx.fillStyle="#fff2c9";ctx.fillRect(x+2,y+5,11,3);ctx.fillRect(x+4,y+1,3,3);ctx.fillRect(x+9,y+8,3,3);return}drawEnemy(e)}
function drawYoshi(o){const x=Math.floor(o.x),y=Math.floor(o.y),f=o.facing||1;ctx.save();if(f<0){ctx.translate(x+18,y);ctx.scale(-1,1)}else ctx.translate(x,y);ctx.fillStyle="#218c43";ctx.fillRect(2,7,5,9);ctx.fillRect(0,11,5,4);ctx.fillStyle="#42bd55";ctx.fillRect(5,4,10,12);ctx.fillRect(10,1,8,9);ctx.fillRect(14,5,6,7);ctx.fillStyle="#f2e4b8";ctx.fillRect(7,10,8,7);ctx.fillStyle="#fff";ctx.fillRect(11,0,5,7);ctx.fillRect(16,2,4,6);ctx.fillStyle="#22212a";ctx.fillRect(14,2,2,2);ctx.fillRect(18,4,1,2);ctx.fillStyle="#df423c";ctx.fillRect(1,7,3,3);ctx.fillRect(3,4,3,3);ctx.fillStyle="#e8a13a";ctx.fillRect(3,16,6,3);ctx.fillRect(13,16,6,3);if(o.tongue>0){ctx.fillStyle="#e87878";ctx.fillRect(19,8,27,2);ctx.fillStyle="#f0a0a0";ctx.fillRect(44,7,4,4)}ctx.restore()}
function drawMario(p,cam){if(!p||p.inv&&Math.floor(p.inv/4)%2)return;let x=Math.floor(p.x-cam),y=Math.floor(p.y),f=p.facing;ctx.save();if(f<0){ctx.translate(x+p.w,y);ctx.scale(-1,1)}else ctx.translate(x,y);const py=p.yoshi?-9:0,big=p.h>16,step=p.onGround&&Math.abs(p.vx)>.3?Math.floor(p.anim/5)%2:0;if(p.yoshi)drawYoshi({x:-3,y:p.h-15,facing:1,tongue:p.yoshi.tongue});if(p.power==="cape"){ctx.fillStyle="#9b6428";ctx.fillRect(-5,py+10,5,11);ctx.fillStyle="#f6cf36";ctx.fillRect(-8,py+8,7,13);ctx.fillRect(-10-(p.spinT?3:0),py+12,6,7);ctx.fillStyle="#fff077";ctx.fillRect(-7,py+9,2,8)}const red=p.power==="fire"?"#f7f3dc":"#e83b3f",blue=p.power==="fire"?"#df3b38":"#2854ad",skin="#f0aa67",hair="#6f3828",shoe="#633328";if(big){ctx.fillStyle=red;ctx.fillRect(1,py,10,3);ctx.fillRect(-1,py+3,15,3);ctx.fillStyle=hair;ctx.fillRect(1,py+6,4,7);ctx.fillRect(4,py+11,3,3);ctx.fillStyle=skin;ctx.fillRect(5,py+6,8,7);ctx.fillRect(12,py+8,3,3);ctx.fillStyle="#231d25";ctx.fillRect(10,py+7,2,2);ctx.fillStyle=red;ctx.fillRect(1,py+13,11,7);ctx.fillRect(-1,py+15,4,5);ctx.fillStyle="#f8f3df";ctx.fillRect(-2,py+18,4,4);ctx.fillStyle=blue;ctx.fillRect(3,py+17,9,7);ctx.fillRect(2,py+22,4,3);ctx.fillRect(9,py+22,4,3);ctx.fillStyle="#f4cc3f";ctx.fillRect(4,py+18,2,2);ctx.fillRect(9,py+18,2,2);ctx.fillStyle=shoe;ctx.fillRect(step?1:0,py+24,6,3);ctx.fillRect(step?9:8,py+24,7,3)}else{ctx.fillStyle=red;ctx.fillRect(1,py,9,3);ctx.fillRect(0,py+3,13,2);ctx.fillStyle=hair;ctx.fillRect(1,py+5,4,5);ctx.fillStyle=skin;ctx.fillRect(5,py+5,8,5);ctx.fillRect(11,py+7,3,2);ctx.fillStyle="#241e24";ctx.fillRect(9,py+6,2,2);ctx.fillStyle=red;ctx.fillRect(2,py+10,9,3);ctx.fillStyle=blue;ctx.fillRect(1,py+12,11,3);ctx.fillStyle=shoe;ctx.fillRect(step?0:1,py+14,5,2);ctx.fillRect(step?8:7,py+14,6,2)}if(p.spinT>0){ctx.fillStyle="#fff9";ctx.fillRect(-4,py+9,3,2);ctx.fillRect(14,py+12,3,2)}ctx.restore()}
function drawHud(){text("MARIO",8,3,"#f44848",undefined,8);text(`× ${game.save.lives}`,14,13,"#fff",undefined,8);text("★",52,4,"#ffe04e",undefined,9);text(String(game.save.stars).padStart(2,"0"),63,5,"#fff",undefined,8);for(let i=0;i<5;i++){ctx.fillStyle=i<game.level.dragons.size?"#ffd43e":"#235d7a99";ctx.fillRect(51+i*7,17,5,7);ctx.fillStyle=i<game.level.dragons.size?"#fff08a":"#78b8cd88";ctx.fillRect(52+i*7,18,2,4)}ctx.fillStyle="#16304ca8";ctx.fillRect(110,1,36,25);ctx.strokeStyle="#f8f5df";ctx.lineWidth=1;ctx.strokeRect(110.5,1.5,35,24);const r=game.player.reserve;if(r){if(r==="cape")cape(121,6);else if(r==="fire")flower(121,6);else mushroom(121,6,"#e94848")}text("TIME",164,3,"#f5de4e",undefined,8);text(String(Math.ceil(game.level.time/60)).padStart(3,"0"),202,3,"#fff",undefined,8);ctx.fillStyle="#f2c52c";ctx.fillRect(166,16,6,8);ctx.fillStyle="#fff07c";ctx.fillRect(168,17,2,5);text(`×${String(game.save.coins).padStart(2,"0")}`,175,16,"#fff",undefined,8);text(String(game.save.score).padStart(7,"0"),251,16,"#fff","right",8);if(game.player.power==="cape"){ctx.fillStyle="#18334aa8";ctx.fillRect(88,4,18,5);ctx.fillStyle="#f5d43d";ctx.fillRect(89,5,16*game.player.pMeter/112,3);if(game.player.pMeter>=112)text("P",97,11,"#fff16a","center",6)}}
function drawMessage(s){const lines=String(s).split("\n");panel(28,35,200,lines.length*11+10,.88);lines.forEach((q,i)=>text(q,128,41+i*11,"#fff4b0","center",8))}function drawDebug(){panel(3,31,112,52,.9);const p=game.player;[`${game.mode} ${game.level.id}/${game.level.areaId}`,`x ${p.x.toFixed(2)} y ${p.y.toFixed(2)}`,`vx ${p.vx.toFixed(3)} vy ${p.vy.toFixed(3)}`,`ground ${+p.onGround} swim ${+p.swimming}`,`P ${p.pMeter}/112 tick ${game.tick}`].forEach((s,i)=>text(s,6,34+i*9,"#8ff5be",undefined,6))}
function drawPause(){panel(34,42,188,139,.94);text("PAUSED",128,51,"#ffe06b","center",13);const p=game.player;[`POWER  ${p.power.toUpperCase()}`,`RESERVE ${p.reserve||"EMPTY"}`,`YOSHI  ${p.yoshi?"YES":"NO"}`,`DRAGON COINS ${game.level.dragons.size}/5`,`MIDWAY ${game.level.midpoint?"YES":"NO"}`,`SWITCH ${game.save.switchOn?"ACTIVE":"DORMANT"}`].forEach((s,i)=>text(s,55,78+i*12,"#fff",undefined,8));text("ESC: RESUME   Q: MAP",128,157,"#d8d0eb","center",7);text("N: RESET SAVE",128,168,"#d8d0eb","center",7)}
function drawDeath(){panel(75,94,106,30,.88);text("COURSE MISS",128,104,"#ffb2a8","center",10)}function drawClear(){panel(52,77,152,60,.9);text(game.clear.secret?"SECRET EXIT!":"COURSE CLEAR!",128,87,game.clear.secret?"#f49add":"#ffe36b","center",11);text(`TIME × ${Math.ceil(game.level.time/60)}`,128,106,"#fff","center",8);text(`DRAGON COINS ${game.level.dragons.size}/5`,128,119,"#fff","center",7)}
function drawGameOver(){ctx.fillStyle="#131020";ctx.fillRect(0,0,W,H);text("GAME OVER",128,82,"#ee6c68","center",18);text("YOUR MAP PROGRESS IS SAFE",128,113,"#ddd5ed","center",7);if(game.deathTick>90)text("PRESS ENTER",128,139,"#ffe36b","center",9)}function drawEnding(){const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,"#38276d");g.addColorStop(1,"#5cc3bd");ctx.fillStyle=g;ctx.fillRect(0,0,W,H);for(let i=0;i<45;i++){ctx.fillStyle=i%2?"#fff":"#ffe371";ctx.fillRect(i*67%256,(i*31+game.tick*.15*(i%4+1))%190,2,2)}text("PRISM ISLES SAVED!",128,45,"#fff1a0","center",15);text("THE RIDGE IS QUIET AGAIN.",128,72,"#fff","center",8);mapMario(122,96);text(`SCORE ${String(game.save.score).padStart(7,"0")}`,128,128,"#ffe371","center",9);text("THANKS FOR PLAYING",128,153,"#fff","center",9);text("ENTER: RETURN TO MAP",128,193,"#dcd4ef","center",7)}

// Bounded fixed 60 Hz loop and deterministic test API -------------------------
let last=performance.now(),acc=0;function frame(now){const dt=Math.min(.1,(now-last)/1000);last=now;acc+=dt;let n=0;while(acc>=STEP&&n<5){update();acc-=STEP;n++}if(n===5)acc=0;render();requestAnimationFrame(frame)}
window.__SMW={snapshot:()=>({mode:game.mode,tick:game.tick,node:game.node,level:game.level?.id,area:game.level?.areaId,player:game.player&&{x:game.player.x,y:game.player.y,vx:game.player.vx,vy:game.player.vy,power:game.player.power,pMeter:game.player.pMeter,onGround:game.player.onGround},progress:JSON.parse(JSON.stringify(game.save))}),loadLevel:(id,a="main")=>loadLevel(id,a),advanceTicks:n=>{for(let i=0;i<Math.max(0,Math.min(36000,n|0));i++)update();render();return window.__SMW.snapshot()},setDebug:v=>game.debug=!!v,resetSave,completeExit:(secret=false)=>game.mode==="level"&&finishLevel(secret),keys:input};
enterTitle();requestAnimationFrame(frame);
</script></body></html>
